# Security headers for every response (Cloudflare Pages).
# X-Content-Type-Options and Referrer-Policy are already added by the Cloudflare zone, so they are not repeated here.
# Inline scripts/styles come from Astro (view transitions, hoisted scripts) and build-time Mermaid SVGs.
# `data:` in script-src: Astro's view-transition router injects an empty `data:` module script to await inline modules.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' data:; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
