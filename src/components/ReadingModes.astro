---
import { getLang, useTranslations } from "../i18n/ui";

const t = useTranslations(getLang(Astro.currentLocale));
const modes = [
  { id: "tldr", label: t("blog.mode.tldr"), hint: t("blog.mode.tldrHint") },
  { id: "normal", label: t("blog.mode.normal"), hint: t("blog.mode.normalHint") },
  { id: "advanced", label: t("blog.mode.advanced"), hint: t("blog.mode.advancedHint") },
] as const;
---

<div class="flex flex-wrap items-center gap-x-3 gap-y-2">
  <div role="radiogroup" aria-label={t("blog.mode.label")} class="reading-modes relative isolate inline-flex rounded-lg border border-paper/25 bg-ink/40 p-1 text-[0.8125rem]">
    <span class="mode-pill" aria-hidden="true"></span>
    {
      modes.map((m) => (
        <button
          type="button"
          role="radio"
          data-mode-option={m.id}
          aria-checked={m.id === "normal" ? "true" : "false"}
          title={m.hint}
          class="rounded-md border border-transparent px-2.5 py-1.5 cursor-pointer font-medium text-paper/70 transition-[color,background-color] duration-200 hover:text-rice focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rice"
        >
          {m.label}
        </button>
      ))
    }
  </div>
</div>

<script>
  const KEY = "reading-mode";
  const MODES = ["tldr", "normal", "advanced"];
  const isMode = (m: string | null): m is string => m !== null && MODES.includes(m);

  const reduceMotion = () => matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Slides the highlight pill under the selected option.
  function placePill() {
    const group = document.querySelector<HTMLElement>(".reading-modes");
    const selected = group?.querySelector<HTMLElement>('[data-mode-option][aria-checked="true"]');
    if (!group || !selected) return;
    // Sub-pixel exact, relative to the group's padding box (where the pill is positioned).
    const g = group.getBoundingClientRect();
    const b = selected.getBoundingClientRect();
    group.style.setProperty("--pill-x", `${b.left - g.left - group.clientLeft}px`);
    group.style.setProperty("--pill-w", `${b.width}px`);
    if (!group.dataset.pill) {
      group.dataset.pill = "";
      // Enable the slide only after the first placement, so it does not animate in on load.
      requestAnimationFrame(() => requestAnimationFrame(() => (group.dataset.pill = "ready")));
    }
  }

  // Fades the post body in after its sections are swapped.
  function fadeContent() {
    if (reduceMotion()) return;
    document.querySelectorAll<HTMLElement>(".reading-content").forEach((el) => {
      el.animate(
        [
          { opacity: 0, transform: "translateY(6px)" },
          { opacity: 1, transform: "none" },
        ],
        { duration: 280, easing: "cubic-bezier(0.2, 0, 0, 1)" },
      );
    });
  }

  function apply(mode: string) {
    document.documentElement.dataset.readingMode = mode;
    document.querySelectorAll<HTMLButtonElement>("[data-mode-option]").forEach((b) => {
      b.setAttribute("aria-checked", String(b.dataset.modeOption === mode));
    });
    placePill();
    // Keep the address bar shareable: `?mode=` reflects the current mode ("normal" is the default, so no param).
    const url = new URL(location.href);
    if (mode === "normal") url.searchParams.delete("mode");
    else url.searchParams.set("mode", mode);
    if (url.href !== location.href) history.replaceState(history.state, "", url);
    // Lets content that cannot render while hidden (e.g. Mermaid) catch up.
    document.dispatchEvent(new CustomEvent("reading-mode-change", { detail: mode }));
  }

  document.addEventListener("astro:page-load", () => {
    const options = document.querySelectorAll<HTMLButtonElement>("[data-mode-option]");
    if (options.length === 0) return;
    // A shared link's `?mode=` wins for this visit without overwriting the reader's saved preference.
    const fromUrl = new URL(location.href).searchParams.get("mode");
    const saved = localStorage.getItem(KEY);
    apply(isMode(fromUrl) ? fromUrl : isMode(saved) ? saved : "normal");
    options.forEach((b) => {
      b.addEventListener("click", () => {
        const mode = b.dataset.modeOption!;
        if (mode === document.documentElement.dataset.readingMode) return;
        localStorage.setItem(KEY, mode);
        apply(mode);
        fadeContent();
      });
    });
    // Button widths change once web fonts load or the viewport resizes.
    const group = document.querySelector<HTMLElement>(".reading-modes");
    if (group) new ResizeObserver(placePill).observe(group);
    document.fonts?.ready.then(placePill);
  });
</script>
