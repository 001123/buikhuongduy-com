---
import { getLang, useTranslations } from "../i18n/ui";
import { pagePath } from "../lib/blog";

interface Props {
  /** Path of page 1, e.g. `/blog/` or `/blog/category/react/`. */
  base: string;
  current: number;
  total: number;
}

const { base, current, total } = Astro.props;
const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

// First, last and the neighbours of the current page; gaps become an ellipsis.
const shown = [...new Set([1, current - 1, current, current + 1, total])].filter((p) => p >= 1 && p <= total).sort((a, b) => a - b);
const items: (number | "gap")[] = shown.flatMap((p, i) => (i > 0 && p - shown[i - 1] > 1 ? ["gap" as const, p] : [p]));

const btn =
  "inline-flex h-8 min-w-8 items-center justify-center gap-1 rounded-md border px-2.5 font-mono text-xs tabular-nums transition-colors sm:h-9 sm:min-w-9 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent";
const idle = "border-border text-fg-secondary hover:border-border-strong hover:text-fg";
const active = "border-fg bg-fg text-bg font-medium";
const disabled = "border-border/50 text-fg-muted/40";
---

{
  total > 1 && (
    <nav aria-label={t("blog.pagination")} class="not-prose mt-10 border-t border-border pt-6">
      <ul class="flex flex-wrap items-center justify-center gap-1.5 sm:gap-2">
        <li>
          {current > 1 ? (
            <a href={pagePath(base, current - 1)} rel="prev" class:list={[btn, idle]}>
              <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-3.5"><path d="M15 18l-6-6 6-6"></path></svg>
              <span class="max-sm:sr-only font-sans">{t("blog.prev")}</span>
            </a>
          ) : (
            <span aria-hidden="true" class:list={[btn, disabled]}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-3.5"><path d="M15 18l-6-6 6-6"></path></svg>
              <span class="max-sm:sr-only font-sans">{t("blog.prev")}</span>
            </span>
          )}
        </li>
        {items.map((item) =>
          item === "gap" ? (
            <li aria-hidden="true" class="px-1 font-mono text-xs text-fg-muted">…</li>
          ) : (
            <li>
              <a
                href={pagePath(base, item)}
                class:list={[btn, item === current ? active : idle]}
                aria-current={item === current ? "page" : undefined}
                aria-label={`${t("blog.page")} ${item}`}
              >
                {item}
              </a>
            </li>
          ),
        )}
        <li>
          {current < total ? (
            <a href={pagePath(base, current + 1)} rel="next" class:list={[btn, idle]}>
              <span class="max-sm:sr-only font-sans">{t("blog.next")}</span>
              <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-3.5"><path d="M9 18l6-6-6-6"></path></svg>
            </a>
          ) : (
            <span aria-hidden="true" class:list={[btn, disabled]}>
              <span class="max-sm:sr-only font-sans">{t("blog.next")}</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-3.5"><path d="M9 18l6-6-6-6"></path></svg>
            </span>
          )}
        </li>
      </ul>
    </nav>
  )
}
