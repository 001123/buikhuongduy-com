---
import { getLang, useTranslations } from "../i18n/ui";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
---

<button
  type="button"
  data-theme-toggle
  aria-label={t("theme.toggle")}
  title={t("theme.toggle")}
  class="inline-flex size-7 items-center justify-center rounded-md text-fg-muted transition-colors hover:bg-surface hover:text-fg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
>
  <!-- Moon icon shown in light mode (click to switch to dark) -->
  <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="size-4 dark:hidden">
    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
  </svg>
  <!-- Sun icon shown in dark mode (click to switch to light) -->
  <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="hidden size-4 dark:block">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
  </svg>
</button>

<script>
  type ViewTransitionLike = {
    ready: Promise<void>;
    finished: Promise<void>;
  };

  type DocumentWithViewTransition = Document & {
    startViewTransition?: (callback: () => void) => ViewTransitionLike;
  };

  let themeTransitionSeq = 0;

  function syncToggleButtons() {
    const isDark = document.documentElement.classList.contains("dark");
    document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]").forEach((btn) => {
      btn.setAttribute("aria-pressed", String(isDark));
    });
  }

  function applyNextTheme(nextDark: boolean) {
    document.documentElement.classList.toggle("dark", nextDark);
    document.documentElement.style.colorScheme = nextDark ? "dark" : "light";
    try {
      localStorage.setItem("theme", nextDark ? "dark" : "light");
    } catch {}
    syncToggleButtons();
  }

  function toggleTheme(btn: HTMLButtonElement) {
    const nextDark = !document.documentElement.classList.contains("dark");
    const doc = document as DocumentWithViewTransition;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (typeof doc.startViewTransition !== "function" || reduceMotion) {
      applyNextTheme(nextDark);
      return;
    }

    const rect = btn.getBoundingClientRect();
    const hasRect = rect.width > 0 || rect.height > 0;
    const x = hasRect ? rect.left + rect.width / 2 : window.innerWidth - 28;
    const y = hasRect ? rect.top + rect.height / 2 : 22;
    const endRadius = Math.hypot(
      Math.max(x, window.innerWidth - x),
      Math.max(y, window.innerHeight - y),
    );

    const seq = ++themeTransitionSeq;
    const root = document.documentElement;
    root.classList.add("theme-transition");

    const transition = doc.startViewTransition(() => {
      applyNextTheme(nextDark);
    });

    transition.ready
      .then(() => {
        root.animate(
          {
            clipPath: [
              `circle(0px at ${x}px ${y}px)`,
              `circle(${endRadius}px at ${x}px ${y}px)`,
            ],
          },
          {
            duration: 500,
            easing: "cubic-bezier(0.22, 1, 0.36, 1)",
            pseudoElement: "::view-transition-new(root)",
          },
        );
      })
      .catch(() => {});

    transition.finished.finally(() => {
      if (seq === themeTransitionSeq) {
        root.classList.remove("theme-transition");
      }
    });
  }

  document.addEventListener("astro:page-load", () => {
    syncToggleButtons();
    document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]").forEach((btn) => {
      if (btn.dataset.bound) return;
      btn.dataset.bound = "1";
      btn.addEventListener("click", () => toggleTheme(btn));
    });
  });
</script>
