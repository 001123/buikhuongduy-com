---
import Background from "./Background.astro";
import { getLang, sectionPaths, useTranslations, type Section } from "../i18n/ui";
import { contentAnim } from "./transitions";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

const primary: Section[] = ["about", "contact", "blog"];
const links = primary.map((s) => ({ label: t(`nav.${s}`), href: sectionPaths[s][lang] }));

/** Turn off once employed to hide the "open to work" line. */
const openToWork = true;

const pill =
  "rounded-full border backdrop-blur-md shadow-lg shadow-ink/30 text-center font-medium tracking-wide glow-hover active:scale-[0.97] active:duration-75 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rice";
---

<main class="relative isolate flex min-h-dvh flex-col items-center justify-start overflow-hidden px-6 pt-[16dvh] pb-16 sm:pt-[12dvh] [@media(max-height:36rem)]:pt-[8dvh]">
  <Background />

  {
    openToWork && (
      <a
        href={sectionPaths.contact[lang]}
        transition:name="open-to-work"
        transition:animate="none"
        data-open-to-work
        class="glow-text-hover group absolute bottom-[max(1.5rem,env(safe-area-inset-bottom))] left-1/2 z-40 inline-flex -translate-x-1/2 whitespace-nowrap sm:bottom-auto sm:translate-x-0 h-[2.375rem] items-center gap-2.5 rounded-full border border-paper/25 bg-ink pr-4 pl-[0.9375rem] text-xs font-medium tracking-wide text-paper/90 shadow-lg shadow-ink/20 hover:border-rice/60 hover:text-paper focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rice sm:top-6 sm:left-6 sm:text-[0.8125rem]"
      >
        <svg data-envelope aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4 text-rice">
          <rect x="3" y="5.5" width="18" height="13" rx="2" />
          <path d="M3 6.5l9 6 9-6" />
        </svg>
        <span>{t("hero.status")}</span>
      </a>
    )
  }

  <div class="flex flex-col items-center gap-6 sm:gap-8" transition:name="content-home" transition:animate={contentAnim}>
    <h1 class="text-center font-serif text-[clamp(2.25rem,10vw,4.5rem)] font-semibold tracking-wide text-balance text-paper text-glow">
      {t("site.name")}
    </h1>

    <p class="relative isolate -mt-3 max-w-md px-2 text-center text-sm leading-relaxed font-medium text-paper text-glow-soft before:absolute before:-inset-x-12 before:-inset-y-5 before:-z-10 before:bg-[radial-gradient(closest-side,rgb(43_29_18/0.6),rgb(43_29_18/0.25)_60%,transparent)] before:content-[''] sm:max-w-2xl sm:text-base sm:-mt-4 sm:text-base">
      {
        t("site.tagline")
          .split("|")
          .map((part, i) => (
            <>
              {i > 0 && " "}
              <span class="inline-block">{part}</span>
            </>
          ))
      }
    </p>

    <span
      aria-hidden="true"
      class="h-px w-24 bg-linear-to-r from-transparent via-rice to-transparent sm:w-40"
    ></span>

    <nav aria-label={t("nav.label")} class="flex w-full max-w-60 flex-col items-stretch gap-3 sm:w-auto sm:max-w-none sm:flex-row sm:justify-center sm:gap-4">
      {
        links.map(({ label, href }) => (
          <a
            href={href}
            class:list={[
              pill,
              "border-paper/50 bg-ink px-6 py-3 text-base text-paper hover:border-rice hover:text-rice sm:min-w-36 sm:px-8 sm:text-lg",
            ]}
          >
            {label}
          </a>
        ))
      }
    </nav>
  </div>
</main>

<style>
  /* Badge "open to work" fades in on its own right after the intro animations so it catches the eye.
     Pure CSS delay (not tied to window load) keeps the last visual change early for Speed Index. */
  [data-open-to-work] {
    /* Rises from below on mobile (pinned to the bottom), drops from above on larger screens (top-left corner). */
    --open-to-work-from: 8px;
    animation: open-to-work-in 0.6s cubic-bezier(0.22, 1, 0.36, 1) 0.9s both;
  }

  @media (min-width: 40rem) {
    [data-open-to-work] {
      --open-to-work-from: -8px;
    }
  }

  @keyframes open-to-work-in {
    from {
      opacity: 0;
      transform: translateY(var(--open-to-work-from)) scale(0.96);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* Envelope wiggles like a new-mail notification while the badge is hovered or focused. */
  [data-open-to-work]:hover [data-envelope],
  [data-open-to-work]:focus-visible [data-envelope] {
    animation: envelope-wiggle 0.6s ease-in-out;
  }

  @keyframes envelope-wiggle {
    0%,
    100% {
      transform: rotate(0);
    }
    15% {
      transform: rotate(-14deg);
    }
    30% {
      transform: rotate(12deg);
    }
    45% {
      transform: rotate(-9deg);
    }
    60% {
      transform: rotate(6deg);
    }
    75% {
      transform: rotate(-3deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-open-to-work],
    [data-open-to-work] [data-envelope] {
      animation: none !important;
    }
  }
</style>
