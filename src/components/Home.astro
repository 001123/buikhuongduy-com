---
import Background from "./Background.astro";
import { getLang, sectionPaths, useTranslations, type Section } from "../i18n/ui";
import { contentAnim } from "./transitions";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

const primary: Section[] = ["about", "blog", "contact"];
const links = primary.map((s) => ({ label: t(`nav.${s}`), href: sectionPaths[s][lang] }));

/** Tắt khi đã có việc để ẩn dòng "đang tìm việc". */
const openToWork = true;

const pill =
  "motion-safe:animate-fade-up rounded-full border backdrop-blur-md shadow-lg shadow-ink/30 text-center font-medium tracking-wide glow-hover hover:-translate-y-0.5 active:translate-y-0 active:scale-[0.97] active:duration-75 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rice";
---

<main class="relative isolate flex min-h-dvh flex-col items-center justify-start overflow-hidden px-6 pt-[16dvh] pb-16 sm:pt-[12dvh]">
  <Background />

  {
    openToWork && (
      <a
        href={sectionPaths.contact[lang]}
        transition:name="open-to-work"
        data-open-to-work
        class="glow-text-hover group absolute top-4 left-4 z-40 inline-flex h-[2.375rem] items-center gap-2.5 rounded-full border border-paper/25 bg-ink/30 pr-4 pl-3.5 text-xs font-medium tracking-wide text-paper/90 shadow-lg shadow-ink/20 backdrop-blur-md hover:border-rice/60 hover:text-paper focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rice sm:top-6 sm:left-6 sm:text-sm"
      >
        <span aria-hidden="true" class="relative flex size-2">
          <span class="absolute inset-0 rounded-full bg-rice motion-safe:animate-ping motion-safe:[animation-duration:2.4s]"></span>
          <span class="relative size-2 rounded-full bg-rice shadow-[0_0_8px_rgb(217_181_74/0.9)]"></span>
        </span>
        <span>{t("hero.status")}</span>
        <span aria-hidden="true" class="hidden text-paper/40 sm:inline">·</span>
        <span class="hidden text-rice sm:inline">{t("nav.contact")}</span>
        <span aria-hidden="true" class="text-rice transition-transform duration-300 group-hover:translate-x-0.5">→</span>
      </a>
    )
  }

  <div class="flex flex-col items-center gap-6 sm:gap-8" transition:name="content-home" transition:animate={contentAnim}>
    <h1 class="motion-safe:animate-fade-up text-center font-serif text-[clamp(2.25rem,10vw,4.5rem)] font-semibold tracking-wide text-balance text-paper text-glow">
      {t("site.name")}
    </h1>

    <p class="motion-safe:animate-fade-up relative isolate -mt-3 max-w-md px-2 text-center text-sm leading-relaxed font-medium text-paper text-glow-soft before:absolute before:-inset-x-12 before:-inset-y-5 before:-z-10 before:bg-[radial-gradient(closest-side,rgb(43_29_18/0.6),rgb(43_29_18/0.25)_60%,transparent)] before:content-[''] sm:max-w-2xl sm:text-base [animation-delay:80ms] sm:-mt-4 sm:text-base">
      {
        t("site.tagline")
          .split("|")
          .map((part, i) => (
            <>
              {i > 0 && " "}
              <span class="inline-block">{part}</span>
            </>
          ))
      }
    </p>

    <span
      aria-hidden="true"
      class="motion-safe:animate-fade-up h-px w-24 bg-linear-to-r from-transparent via-rice to-transparent [animation-delay:150ms] sm:w-40"
    ></span>

    <nav aria-label={t("nav.label")} class="flex w-full max-w-60 flex-col items-stretch gap-3 sm:w-auto sm:max-w-none sm:flex-row sm:justify-center sm:gap-4">
      {
        links.map(({ label, href }, i) => (
          <a
            href={href}
            style={`animation-delay: ${300 + i * 120}ms`}
            class:list={[
              pill,
              "border-paper/50 bg-ink/40 px-6 py-3 text-base text-paper hover:border-rice hover:bg-ink/60 hover:text-rice sm:min-w-36 sm:px-8 sm:text-lg",
            ]}
          >
            {label}
          </a>
        ))
      }
    </nav>
  </div>
</main>

<style>
  /* Badge "open to work" stays hidden until the page has fully loaded, then fades in on its own so it catches the eye. */
  [data-open-to-work]:not([data-ready]) {
    opacity: 0;
    pointer-events: none;
  }

  [data-open-to-work][data-ready] {
    animation: open-to-work-in 0.9s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @keyframes open-to-work-in {
    from {
      opacity: 0;
      transform: translateY(-8px) scale(0.96);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-open-to-work][data-ready] {
      animation: none;
    }
  }
</style>

<noscript>
  <style>
    [data-open-to-work] {
      opacity: 1 !important;
      pointer-events: auto !important;
    }
  </style>
</noscript>

<script>
  // Wait for the full load (background image included) plus a short pause after the intro animations.
  const REVEAL_DELAY_MS = 500;

  function reveal() {
    const el = document.querySelector<HTMLElement>("[data-open-to-work]");
    if (!el || "ready" in el.dataset) return;
    const show = () => setTimeout(() => (el.dataset.ready = ""), REVEAL_DELAY_MS);
    if (document.readyState === "complete") show();
    else window.addEventListener("load", show, { once: true });
  }

  document.addEventListener("astro:page-load", reveal);
</script>
