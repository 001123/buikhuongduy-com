---
import { getImage } from "astro:assets";
import heroPixelDark from "../assets/hero-pixel-dark.jpg";
import heroPixelLight from "../assets/hero-pixel-light.jpg";
import HeroCard from "./HeroCard.astro";
import PostList from "./PostList.astro";
import { projects } from "../data/projects";
import { getLang, sectionPaths, useTranslations } from "../i18n/ui";
import { getPosts } from "../lib/blog";
import { contentAnim } from "./transitions";

const lightHeroBg = await getImage({ src: heroPixelLight, width: 1440, format: "webp", quality: 82 });
const darkHeroBg = await getImage({ src: heroPixelDark, width: 1440, format: "webp", quality: 82 });

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const latest = (await getPosts(lang)).slice(0, 5);
const allProjects = projects[lang];
const kdCode = allProjects[0];
const simpleOtp = allProjects[1];
const otherProjects = allProjects.slice(2);

/** Turn off once employed to hide the "open to work" line. */
const openToWork = true;

const stats = [
  { num: "9", suffix: "+", label: t("home.statYears"), note: "Full-Stack · AI-Native" },
  { num: "30M", suffix: "+", label: t("home.statTraffic"), note: "Hello Health Group" },
  { num: "2M", suffix: "+", label: t("home.statUsers"), note: "Saladin Insurance" },
  { num: "100", suffix: "×4", label: t("home.statLighthouse"), note: "Perf · A11y · BP · SEO" },
];

const kdAgents = [
  {
    id: "claude",
    name: "Claude",
    branch: "wt/claude-ui",
    diff: "+184 -42",
    time: "14.2s",
    status: lang === "vi" ? "Tốt nhất · Best-of-N" : "Selected · Best-of-N",
    log: "refactor(tokens): unify light & dark surface variables across 12 components",
  },
  {
    id: "codex",
    name: "Codex",
    branch: "wt/codex-api",
    diff: "+129 -31",
    time: "11.8s",
    status: lang === "vi" ? "Đã kiểm tra · 0 lỗi" : "Verified · 0 errors",
    log: "feat(acp): stream tool-call progress over stdio JSON-RPC channel",
  },
  {
    id: "opencode",
    name: "OpenCode",
    branch: "wt/opencode-diff",
    diff: "+96 -19",
    time: "16.4s",
    status: lang === "vi" ? "Sẵn sàng merge" : "Ready to merge",
    log: "test(worktree): isolate git index locks per concurrent coding agent",
  },
];
---

<div transition:name="content-home" transition:animate={contentAnim}>
  <!-- Section 1: Pixel-Art HCMC Skyline Hero + Interactive Engineering Card -->
  <section data-hero-section aria-label={t("site.name")} class="relative overflow-hidden border-b border-border">
    <div
      aria-hidden="true"
      class="hero-pixel-bg pointer-events-none absolute inset-0"
      style={`--hero-bg-light: url(${lightHeroBg.src}); --hero-bg-dark: url(${darkHeroBg.src});`}
    ></div>
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 bg-gradient-to-r from-bg/88 via-bg/35 to-transparent"
    ></div>
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-bg via-bg/40 to-transparent"
    ></div>

    <div class="relative mx-auto max-w-6xl px-5 pt-10 pb-12 sm:px-8 sm:pt-14 sm:pb-16">
      <!-- Live telemetry bar -->
      <div class="flex flex-wrap items-center justify-between gap-3 font-mono text-xs text-fg-muted">
        <span class="inline-flex items-center gap-2">
          <span aria-hidden="true" class="size-1.5 rounded-full bg-accent-vivid"></span>
          <span>{t("home.edition")}</span>
          <span aria-hidden="true" class="text-border-strong">·</span>
          <time data-hcmc-clock class="tabular-nums text-fg-secondary">--:--:-- ICT</time>
        </span>

        {
          openToWork && (
            <a
              href={sectionPaths.contact[lang]}
              class="open-status-pill group inline-flex items-center gap-2 rounded-full border border-border bg-surface-elevated/95 px-3 py-1 text-fg-secondary transition-colors hover:border-accent/50 hover:text-fg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
            >
              <span aria-hidden="true" class="relative flex size-2">
                <span class="status-ping-ring absolute inline-flex h-full w-full rounded-full bg-status-open opacity-75"></span>
                <span class="relative inline-flex size-2 rounded-full bg-status-open"></span>
              </span>
              <span>{t("hero.status")}</span>
              <span aria-hidden="true" class="transition-transform duration-200 group-hover:translate-x-0.5">→</span>
            </a>
          )
        }
      </div>

      <!-- Balanced 2-Column Hero Main Area -->
      <div class="mt-7 grid items-center gap-8 lg:grid-cols-[minmax(0,1fr)_24.5rem] lg:gap-10 xl:grid-cols-[minmax(0,1fr)_26.5rem]">
        <div>
          <!-- Monumental Display Title -->
          <h1 class="text-[clamp(2.5rem,5.2vw,4.35rem)] font-semibold leading-[1.0] tracking-[-0.04em] text-fg">
            {t("site.name")}
          </h1>

          <!-- Positioning Copy -->
          <p class="mt-4 max-w-xl text-base leading-relaxed text-pretty text-fg-secondary sm:text-lg">
            {t("home.intro")}
          </p>
        </div>

        <HeroCard />
      </div>

      <!-- Prominent Impact Metrics Bar directly inside Hero -->
      <div class="mt-10 grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-border-strong bg-border shadow-sm lg:grid-cols-4">
        {
          stats.map((s) => (
            <div class="spotlight-card rounded-none border-0 bg-surface-elevated/95 p-5 sm:p-6">
              <div aria-hidden="true" class="mb-3 h-1 w-7 rounded-full bg-accent-vivid"></div>
              <p class="text-3xl font-bold tracking-[-0.04em] text-fg tabular-nums sm:text-4xl lg:text-[2.65rem]">
                <span>{s.num}</span><span class="text-accent">{s.suffix}</span>
              </p>
              <p class="mt-1.5 text-sm font-medium text-fg">{s.label}</p>
              <p class="mt-0.5 font-mono text-[0.6875rem] text-fg-muted">{s.note}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Section 01: Latest Writing (Moved above Projects) -->
  {
    latest.length > 0 && (
      <section aria-labelledby="latest-posts" class="mx-auto max-w-6xl px-5 py-14 sm:px-8 sm:py-16">
        <div class="grid gap-8 lg:grid-cols-[18rem_1fr] lg:gap-12">
          <div class="lg:sticky lg:top-24 lg:self-start">
            <p class="font-mono text-xs font-medium uppercase tracking-[0.12em] text-accent">01</p>
            <h2 id="latest-posts" class="mt-1 text-2xl font-semibold tracking-[-0.03em] text-fg sm:text-3xl">
              {t("blog.latest")}
            </h2>
            <p class="mt-2 text-sm leading-relaxed text-fg-secondary">{t("home.blogDesc")}</p>
            <a
              href={sectionPaths.blog[lang]}
              class="mt-5 inline-flex items-center gap-1.5 rounded-full border border-border-strong bg-surface-elevated px-4 py-2 text-xs font-medium text-fg transition-colors hover:border-accent hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
            >
              <span>{t("blog.back")}</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>

          <PostList posts={latest} headingLevel="h3" compact numbered class="border-y border-border" />
        </div>
      </section>
    )
  }

  <!-- Section 02: Interactive Spotlight Bento Grid -->
  <section aria-labelledby="home-projects" class="mx-auto max-w-6xl px-5 pb-20 sm:px-8 sm:pb-24">
    <div class="border-t border-border pt-14">
      <div class="mb-8 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="font-mono text-xs font-medium uppercase tracking-[0.12em] text-accent">02</p>
          <h2 id="home-projects" class="mt-1 text-2xl font-semibold tracking-[-0.03em] text-fg sm:text-3xl">
            {t("home.projects")}
          </h2>
          <p class="mt-1 text-sm text-fg-secondary">{t("home.projectsDesc")}</p>
        </div>
        <a
          href={sectionPaths.about[lang]}
          class="inline-flex items-center gap-1.5 font-mono text-xs text-fg-muted transition-colors hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
        >
          <span>{t("home.allProjects")}</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="grid gap-4 lg:grid-cols-12">
        <!-- Bento 1: KD Code Interactive Agent Switcher -->
        <article data-reveal="pending" class="spotlight-card flex flex-col rounded-2xl p-6 lg:col-span-7">
          <div class="flex items-baseline justify-between gap-4">
            <h3 class="text-xl font-semibold tracking-[-0.02em] text-fg">{kdCode.name}</h3>
            <a
              href={kdCode.href}
              target="_blank"
              rel="noopener"
              class="font-mono text-xs text-fg-muted transition-colors hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
            >
              {t("home.kdCodeMarketplace")}
            </a>
          </div>

          <p class="mt-2 text-sm leading-relaxed text-fg-secondary">{kdCode.summary}</p>

          <!-- Interactive multi-agent worktree switcher -->
          <div data-kd-demo class="my-5 rounded-xl border border-border bg-surface p-3.5 font-mono text-xs">
            <div class="flex flex-wrap items-center justify-between gap-2 border-b border-border pb-3">
              <div role="tablist" aria-label="KD Code agents" class="flex items-center gap-1">
                {
                  kdAgents.map((a, idx) => (
                    <button
                      type="button"
                      role="tab"
                      data-agent-tab={a.id}
                      data-branch={a.branch}
                      data-diff={a.diff}
                      data-time={a.time}
                      data-status={a.status}
                      data-log={a.log}
                      aria-selected={idx === 0 ? "true" : "false"}
                      class:list={[
                        "rounded-md px-2.5 py-1 text-xs font-medium transition-colors focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-accent",
                        idx === 0 ? "bg-accent text-accent-fg" : "text-fg-muted hover:bg-surface-elevated hover:text-fg",
                      ]}
                    >
                      {a.name}
                    </button>
                  ))
                }
              </div>
              <span data-kd-status class="text-[0.6875rem] text-accent">{kdAgents[0].status}</span>
            </div>

            <div class="mt-3 flex flex-wrap items-center justify-between gap-2 text-[0.75rem]">
              <span data-kd-branch class="font-medium text-fg">{kdAgents[0].branch}</span>
              <div class="flex items-center gap-3 tabular-nums">
                <span data-kd-diff class="text-status-open">{kdAgents[0].diff}</span>
                <span data-kd-time class="text-fg-muted">{kdAgents[0].time}</span>
              </div>
            </div>
            <p data-kd-log class="mt-2 truncate text-[0.75rem] text-fg-secondary">{kdAgents[0].log}</p>
          </div>

          <p class="mt-auto font-mono text-[0.75rem] text-fg-muted">{kdCode.tags.join(" · ")}</p>
        </article>

        <!-- Bento 2: Simple OTP Live 2FA Ring & Click-to-Copy -->
        <article data-reveal="pending" class="spotlight-card flex flex-col rounded-2xl p-6 lg:col-span-5">
          <div class="flex items-baseline justify-between gap-4">
            <h3 class="text-xl font-semibold tracking-[-0.02em] text-fg">{simpleOtp.name}</h3>
            <a
              href={simpleOtp.href}
              target="_blank"
              rel="noopener"
              class="font-mono text-xs text-fg-muted transition-colors hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
            >
              {t("home.simpleOtpGithub")}
            </a>
          </div>

          <p class="mt-2 text-sm leading-relaxed text-fg-secondary">{simpleOtp.summary}</p>

          <div data-totp-widget class="my-5 flex items-center justify-between gap-4 rounded-xl border border-border bg-surface p-4">
            <div>
              <p class="font-mono text-[0.6875rem] uppercase tracking-wider text-fg-muted">{t("home.otpLabel")}</p>
              <button
                type="button"
                data-totp-copy
                data-label-idle={t("home.otpCopy")}
                data-label-copied={t("home.otpCopied")}
                title={t("home.otpCopy")}
                class="group mt-1.5 flex items-baseline gap-2.5 text-left focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
              >
                <span data-totp-code class="font-mono text-2xl font-medium tracking-[0.18em] text-fg tabular-nums sm:text-[1.75rem]">
                  482 917
                </span>
                <span data-totp-copy-label class="rounded border border-border bg-surface-elevated px-1.5 py-0.5 font-mono text-[0.625rem] text-fg-muted transition-colors group-hover:border-border-strong group-hover:text-fg">
                  {t("home.otpCopy")}
                </span>
              </button>
            </div>

            <!-- Circular 30s SVG countdown -->
            <div class="relative grid size-12 shrink-0 place-items-center">
              <svg viewBox="0 0 36 36" class="size-12 -rotate-90" aria-hidden="true">
                <circle cx="18" cy="18" r="15" fill="none" stroke="var(--border-strong)" stroke-width="2.5"></circle>
                <circle
                  data-totp-ring
                  cx="18"
                  cy="18"
                  r="15"
                  fill="none"
                  stroke="var(--accent-vivid)"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-dasharray="94.25"
                  stroke-dashoffset="18"
                  class="transition-[stroke-dashoffset] duration-300 ease-linear"
                ></circle>
              </svg>
              <span data-totp-sec class="font-mono text-[0.6875rem] tabular-nums text-fg-secondary">24s</span>
            </div>
          </div>

          <p class="mt-auto font-mono text-[0.75rem] text-fg-muted">{simpleOtp.tags.join(" · ")}</p>
        </article>

        <!-- Supporting Projects -->
        {
          otherProjects.map((p) => (
            <a
              href={p.href}
              target="_blank"
              rel="noopener"
              data-reveal="pending"
              class="spotlight-card group flex flex-col rounded-2xl p-6 lg:col-span-6 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
            >
              <div class="flex items-baseline justify-between gap-2">
                <h3 class="text-lg font-semibold tracking-[-0.02em] text-fg transition-colors group-hover:text-accent">
                  {p.name}
                </h3>
                <span aria-hidden="true" class="font-mono text-xs text-fg-muted transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-accent">
                  ↗
                </span>
              </div>
              <p class="mt-2 text-sm leading-relaxed text-fg-secondary">{p.summary}</p>
              <p class="mt-auto pt-4 font-mono text-[0.75rem] text-fg-muted">{p.tags.join(" · ")}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</div>

<script>
  let homeTimer: number | undefined;

  function formatTotp(step: number): string {
    let h = (step * 2654435761) >>> 0;
    h = ((h ^ (h >>> 16)) * 0x45d9f3b) >>> 0;
    const code = String(h % 1_000_000).padStart(6, "0");
    return `${code.slice(0, 3)} ${code.slice(3)}`;
  }

  function initReveals() {
    const reveals = [...document.querySelectorAll<HTMLElement>("[data-reveal]")];
    if (reveals.length === 0) return;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduceMotion || !("IntersectionObserver" in window)) {
      reveals.forEach((el) => (el.dataset.reveal = "visible"));
      return;
    }

    document.documentElement.classList.add("reveal-ready");
    const revealVisible = () => {
      const limit = window.innerHeight * 1.05;
      reveals.forEach((el) => {
        if (el.dataset.reveal === "visible") return;
        if (el.getBoundingClientRect().top <= limit) el.dataset.reveal = "visible";
      });
    };

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting || entry.boundingClientRect.top <= window.innerHeight) {
            (entry.target as HTMLElement).dataset.reveal = "visible";
            io.unobserve(entry.target);
          }
        });
      },
      { rootMargin: "80px 0px 80px 0px", threshold: 0.01 },
    );

    reveals.forEach((el) => io.observe(el));
    revealVisible();
    window.addEventListener("scroll", revealVisible, { passive: true });
    window.setTimeout(() => {
      reveals.forEach((el) => (el.dataset.reveal = "visible"));
      window.removeEventListener("scroll", revealVisible);
      io.disconnect();
    }, 1500);
  }

  function initMotionCraft() {
    clearInterval(homeTimer);

    const canHover = window.matchMedia("(hover: hover)").matches;

    if (canHover) {
      document.querySelectorAll<HTMLElement>(".spotlight-card").forEach((card) => {
        if (card.dataset.spotBound) return;
        card.dataset.spotBound = "1";
        card.addEventListener(
          "pointermove",
          (e) => {
            const rect = card.getBoundingClientRect();
            card.style.setProperty("--mx", `${e.clientX - rect.left}px`);
            card.style.setProperty("--my", `${e.clientY - rect.top}px`);
          },
          { passive: true },
        );
      });
    }

    const kdDemo = document.querySelector<HTMLElement>("[data-kd-demo]");
    if (kdDemo && !kdDemo.dataset.bound) {
      kdDemo.dataset.bound = "1";
      const tabs = kdDemo.querySelectorAll<HTMLButtonElement>("[data-agent-tab]");
      const statusEl = kdDemo.querySelector<HTMLElement>("[data-kd-status]")!;
      const branchEl = kdDemo.querySelector<HTMLElement>("[data-kd-branch]")!;
      const diffEl = kdDemo.querySelector<HTMLElement>("[data-kd-diff]")!;
      const timeEl = kdDemo.querySelector<HTMLElement>("[data-kd-time]")!;
      const logEl = kdDemo.querySelector<HTMLElement>("[data-kd-log]")!;

      tabs.forEach((tab) => {
        tab.addEventListener("click", () => {
          tabs.forEach((t) => {
            const active = t === tab;
            t.setAttribute("aria-selected", String(active));
            t.className = active
              ? "rounded-md bg-accent px-2.5 py-1 text-xs font-medium text-accent-fg transition-colors focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-accent"
              : "rounded-md px-2.5 py-1 text-xs font-medium text-fg-muted transition-colors hover:bg-surface-elevated hover:text-fg focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-accent";
          });
          statusEl.textContent = tab.dataset.status ?? "";
          branchEl.textContent = tab.dataset.branch ?? "";
          diffEl.textContent = tab.dataset.diff ?? "";
          timeEl.textContent = tab.dataset.time ?? "";
          logEl.textContent = tab.dataset.log ?? "";
        });
      });
    }

    const clockEl = document.querySelector<HTMLElement>("[data-hcmc-clock]");
    const widget = document.querySelector<HTMLElement>("[data-totp-widget]");
    const codeEl = widget?.querySelector<HTMLElement>("[data-totp-code]");
    const secEl = widget?.querySelector<HTMLElement>("[data-totp-sec]");
    const ringEl = widget?.querySelector<SVGCircleElement>("[data-totp-ring]");
    const copyBtn = widget?.querySelector<HTMLButtonElement>("[data-totp-copy]");
    const copyLabel = widget?.querySelector<HTMLElement>("[data-totp-copy-label]");

    if (copyBtn && copyLabel && codeEl && !copyBtn.dataset.bound) {
      copyBtn.dataset.bound = "1";
      let resetTimer: number | undefined;
      copyBtn.addEventListener("click", async () => {
        const raw = (codeEl.textContent ?? "").replace(/\s+/g, "");
        try {
          await navigator.clipboard.writeText(raw);
        } catch {
          return;
        }
        copyLabel.textContent = copyBtn.dataset.labelCopied ?? "Copied";
        copyLabel.classList.add("text-accent", "border-accent");
        clearTimeout(resetTimer);
        resetTimer = window.setTimeout(() => {
          copyLabel.textContent = copyBtn.dataset.labelIdle ?? "Copy";
          copyLabel.classList.remove("text-accent", "border-accent");
        }, 1600);
      });
    }

    const formatter = new Intl.DateTimeFormat("en-GB", {
      timeZone: "Asia/Ho_Chi_Minh",
      hour: "2-digit",
      minute: "2-digit",
      second: "2-digit",
      hour12: false,
    });

    const CIRC = 2 * Math.PI * 15;

    const tickTelemetry = () => {
      const now = new Date();
      if (clockEl && document.contains(clockEl)) {
        clockEl.textContent = `${formatter.format(now)} ICT`;
      }
      if (widget && document.contains(widget) && codeEl && secEl && ringEl) {
        const nowSec = Math.floor(now.getTime() / 1000);
        const step = Math.floor(nowSec / 30);
        const rem = 30 - (nowSec % 30);
        codeEl.textContent = formatTotp(step);
        secEl.textContent = `${rem}s`;
        ringEl.style.strokeDashoffset = String(CIRC * (1 - rem / 30));
      }
      if (!clockEl?.isConnected && !widget?.isConnected) {
        clearInterval(homeTimer);
      }
    };

    if (clockEl || widget) {
      tickTelemetry();
      homeTimer = window.setInterval(tickTelemetry, 1000);
    }
  }

  document.addEventListener("astro:page-load", () => {
    initReveals();
    if (typeof requestIdleCallback === "function") requestIdleCallback(initMotionCraft);
    else requestAnimationFrame(initMotionCraft);
  });
</script>
