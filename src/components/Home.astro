---
import ContactIcon from "./ContactIcon.astro";
import ExperienceTimeline from "./ExperienceTimeline.astro";
import HeroCard from "./HeroCard.astro";
import HeroMascot from "./HeroMascot.astro";
import PostList from "./PostList.astro";
import ProjectCard from "./ProjectCard.astro";
import ProjectFilter from "./ProjectFilter.astro";
import SectionPixelDecor from "./SectionPixelDecor.astro";
import { experiences } from "../data/experience";
import { cvUrl, socials } from "../data/profile";
import { projects } from "../data/projects";
import { getLang, sectionPaths, useTranslations } from "../i18n/ui";
import { categoryPath, getCategories, getPosts } from "../lib/blog";
import { contentAnim } from "./transitions";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const allPosts = await getPosts(lang);
const latest = allPosts.slice(0, 5);
const topCategories = (await getCategories(lang))
  .slice()
  .sort((a, b) => b.posts.length - a.posts.length)
  .slice(0, 6);
const totalPostsLabel = t("blog.totalPosts").replace("{n}", String(allPosts.length));
const allProjects = projects[lang];
const kdCode = allProjects[0];
const simpleOtp = allProjects[1];
const otherProjects = allProjects.slice(2);
const experienceList = experiences[lang];

const stats = [
  { num: "9", suffix: "+", label: t("home.statYears"), note: "Full-Stack · AI-Native" },
  { num: "30M", suffix: "+", label: t("home.statTraffic"), note: "Healthcare · Next.js" },
  { num: "2M", suffix: "+", label: t("home.statUsers"), note: "Insurtech · Design System" },
  { num: "10M", suffix: "+", label: t("home.statDownloads"), note: "Mobile · Enterprise" },
];

const kdAgents = [
  {
    id: "claude",
    name: "Claude",
    branch: "wt/claude-ui",
    diff: "+184 -42",
    time: "14.2s",
    status: lang === "vi" ? "Tốt nhất · Best-of-N" : "Selected · Best-of-N",
    log: "refactor(tokens): unify light & dark surface variables across 12 components",
  },
  {
    id: "codex",
    name: "Codex",
    branch: "wt/codex-api",
    diff: "+129 -31",
    time: "11.8s",
    status: lang === "vi" ? "Đã kiểm tra · 0 lỗi" : "Verified · 0 errors",
    log: "feat(acp): stream tool-call progress over stdio JSON-RPC channel",
  },
  {
    id: "opencode",
    name: "OpenCode",
    branch: "wt/opencode-diff",
    diff: "+96 -19",
    time: "16.4s",
    status: lang === "vi" ? "Sẵn sàng merge" : "Ready to merge",
    log: "test(worktree): isolate git index locks per concurrent coding agent",
  },
];
---

<div transition:name="content-home" transition:animate={contentAnim}>
  <!-- Section 1: Hero + AI-Native Isometric Studio + Impact Metrics + Interactive Profile -->
  <section data-hero-section aria-label={t("site.name")} class="relative overflow-hidden border-b border-border">
    <div class="relative mx-auto max-w-6xl px-5 pt-5 pb-8 sm:px-8 sm:pt-6 sm:pb-10">
      <!-- Hero Identity + Primary CTAs -->
      <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between lg:gap-8">
        <div class="min-w-0">
          <p class="inline-flex items-center gap-2 font-mono text-[0.625rem] font-medium uppercase tracking-[0.06em] text-accent sm:text-[0.6875rem] sm:tracking-[0.12em]">
            <span aria-hidden="true" class="h-px w-4 shrink-0 bg-accent-vivid sm:w-5"></span>
            <span>{t("home.kicker")}</span>
          </p>

          <h1 class="mt-2 text-[clamp(2.25rem,4.4vw,3.75rem)] font-semibold leading-[1.03] tracking-[-0.04em] text-fg">
            {t("site.name")}
          </h1>

          <p class="mt-2.5 max-w-2xl text-base leading-relaxed text-pretty text-fg-secondary sm:text-[1.0625rem]">
            {t("home.intro")}
          </p>
        </div>

        <div class="flex shrink-0 flex-wrap items-center gap-2 lg:flex-col lg:items-end lg:gap-2.5">
          <div class="flex items-center gap-2">
            <a
              href={sectionPaths.contact[lang]}
              class="inline-flex h-9 items-center gap-2 rounded-full bg-accent px-4 text-xs font-semibold text-accent-fg shadow-xs transition-transform duration-150 hover:-translate-y-0.5 hover:opacity-95 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
            >
              <span>{t("nav.contact")}</span>
              <span aria-hidden="true">→</span>
            </a>
            <a
              href={cvUrl}
              target="_blank"
              rel="noopener"
              class="inline-flex h-9 items-center gap-1.5 rounded-full border border-border-strong bg-surface-elevated px-3.5 font-mono text-xs font-medium text-fg transition-colors hover:border-accent hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
            >
              <ContactIcon name="cv" class="size-3.5 text-accent" />
              <span>{t("nav.cv")}</span>
              <span aria-hidden="true">↗</span>
            </a>
          </div>

          <div class="flex items-center gap-1.5">
            {
              socials.map((s) => (
                <a
                  href={s.href}
                  target="_blank"
                  rel="noopener"
                  aria-label={s.label}
                  title={s.label}
                  class="inline-flex size-9 items-center justify-center rounded-full border border-border bg-surface-elevated text-fg-muted transition-colors hover:border-accent/60 hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
                >
                  <ContactIcon name={s.icon} class="size-4" />
                </a>
              ))
            }
          </div>
        </div>
      </div>

      <!-- AI-Native Isometric Pixel Studio seamlessly joined above Impact Metrics Bar -->
      <div class="mt-4 overflow-hidden rounded-2xl border border-border-strong bg-surface-elevated shadow-sm sm:mt-5">
        <HeroMascot />

        <div class="grid grid-cols-2 gap-px border-t border-border bg-border lg:grid-cols-4">
          {
            stats.map((s) => (
              <div class="spotlight-card rounded-none border-0 bg-surface-elevated/95 p-4 sm:px-5 sm:py-4.5">
                <div aria-hidden="true" class="mb-2 h-1 w-7 rounded-full bg-accent-vivid"></div>
                <p class="text-2xl font-bold tracking-[-0.04em] text-fg tabular-nums sm:text-3xl lg:text-[2.25rem]">
                  <span>{s.num}</span><span class="text-accent">{s.suffix}</span>
                </p>
                <p class="mt-1 text-sm font-medium text-fg">{s.label}</p>
                <p class="mt-0.5 font-mono text-[0.6875rem] text-fg-muted">{s.note}</p>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Engineering Profile Card (moved below studio & metrics for clear above-the-fold hierarchy) -->
      <div class="mt-5 sm:mt-6">
        <HeroCard />
      </div>
    </div>
  </section>

  <!-- Section: Latest Writing (Editorial surface on clean bg) -->
  {
    latest.length > 0 && (
      <section aria-labelledby="latest-posts" class="bg-bg">
        <div class="mx-auto max-w-6xl px-5 py-14 sm:px-8 sm:py-16">
          <div class="grid gap-8 lg:grid-cols-[18.5rem_1fr] lg:gap-12">
            <div class="lg:sticky lg:top-24 lg:self-start">
              <SectionPixelDecor variant="writing" class="mb-3" />

              <p class="inline-flex items-center gap-2 font-mono text-[0.625rem] font-medium uppercase tracking-[0.06em] text-accent sm:text-[0.6875rem] sm:tracking-[0.12em]">
                <span aria-hidden="true" class="h-px w-4 shrink-0 bg-accent-vivid sm:w-5"></span>
                <span>{t("section.blogKicker")}</span>
              </p>

              <div class="mt-2.5 flex flex-wrap items-baseline gap-2.5">
                <h2 id="latest-posts" class="text-2xl font-semibold tracking-[-0.03em] text-fg sm:text-3xl">
                  {t("blog.latest")}
                </h2>
                <span class="rounded-full border border-border bg-surface px-2.5 py-0.5 font-mono text-[0.6875rem] tabular-nums text-fg-muted">
                  {totalPostsLabel}
                </span>
              </div>

              <p class="mt-2 text-sm leading-relaxed text-fg-secondary">{t("home.blogDesc")}</p>

              <div class="mt-5 flex flex-wrap items-center gap-2">
                <a
                  href={sectionPaths.blog[lang]}
                  class="inline-flex h-9 items-center gap-1.5 rounded-full bg-fg px-4 text-xs font-medium text-bg transition-transform duration-150 hover:-translate-y-0.5 hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
                >
                  <span>{t("blog.back")}</span>
                  <span aria-hidden="true">→</span>
                </a>

                <button
                  type="button"
                  data-cmd-open
                  class="inline-flex h-9 items-center gap-2 rounded-full border border-border-strong bg-surface-elevated px-3.5 text-xs font-medium text-fg-secondary transition-colors hover:border-accent hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
                >
                  <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="size-3.5">
                    <circle cx="11" cy="11" r="7"></circle>
                    <path d="m20 20-3.5-3.5"></path>
                  </svg>
                  <span>{t("nav.search")}</span>
                  <kbd class="rounded border border-border bg-surface px-1 font-mono text-[0.625rem] leading-4 text-fg-muted">⌘K</kbd>
                </button>
              </div>

              {topCategories.length > 0 && (
                <div class="mt-6 border-t border-border pt-5">
                  <p class="font-mono text-[0.6875rem] uppercase tracking-[0.1em] text-fg-muted">
                    {t("blog.topics")}
                  </p>
                  <ul class="mt-2.5 flex flex-wrap gap-1.5">
                    {topCategories.map((c) => (
                      <li>
                        <a
                          href={categoryPath(lang, c.slug)}
                          class="inline-flex items-center gap-1.5 rounded-lg border border-border bg-surface-elevated px-2.5 py-1 text-xs font-medium text-fg-secondary transition-colors hover:border-accent/60 hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
                        >
                          <span>{c.name}</span>
                          <span class="font-mono text-[0.6875rem] tabular-nums text-fg-muted">{c.posts.length}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>

            <PostList posts={latest} headingLevel="h3" compact />
          </div>
        </div>
      </section>
    )
  }

  <!-- Section: Interactive Spotlight Bento Grid (Workshop Stage on matte surface band) -->
  <section aria-labelledby="home-projects" data-projects-scope class="border-y border-border bg-surface/80 dark:bg-surface/75">
    <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-20 [&_.spotlight-card]:shadow-[0_1px_2px_rgba(0,0,0,0.04)] dark:[&_.spotlight-card]:shadow-none">
      <div class="mb-8 flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <SectionPixelDecor variant="projects" class="mb-3" />
          <h2 id="home-projects" class="text-2xl font-semibold tracking-[-0.03em] text-fg sm:text-3xl">
            {t("home.projects")}
          </h2>
          <p class="mt-1 text-sm text-fg-secondary">{t("home.projectsDesc")}</p>
        </div>
        <div class="flex flex-wrap items-center gap-3">
          <ProjectFilter projects={allProjects} lang={lang} />
          <a
            href={sectionPaths.about[lang]}
            class="inline-flex items-center gap-1.5 font-mono text-xs text-fg-muted transition-colors hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
          >
            <span>{t("home.allProjects")}</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <div class="grid gap-4 lg:grid-cols-12">
        <!-- Bento 1: KD Code Interactive Agent Switcher -->
        <article
          data-reveal="pending"
          data-project-category={kdCode.category}
          class="spotlight-card flex flex-col rounded-2xl p-6 lg:col-span-7"
        >
          <div class="flex flex-wrap items-center justify-between gap-3">
            <div class="flex flex-wrap items-center gap-2">
              <span class="rounded-md border border-accent/25 bg-accent-soft/75 px-2 py-0.5 font-mono text-[0.6875rem] font-medium text-accent">
                {t("projects.badgeOpenSource")}
              </span>
              <span class="font-mono text-[0.6875rem] text-fg-muted">{kdCode.org} · {kdCode.period}</span>
            </div>
            <a
              href={kdCode.href}
              target="_blank"
              rel="noopener"
              class="font-mono text-xs text-fg-muted transition-colors hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
            >
              {t("home.kdCodeMarketplace")}
            </a>
          </div>

          <h3 class="mt-3 text-xl font-semibold tracking-[-0.02em] text-fg">{kdCode.name}</h3>

          <p class="mt-2 text-sm leading-relaxed text-fg-secondary">{kdCode.summary}</p>

          <!-- Interactive multi-agent worktree switcher -->
          <div data-kd-demo class="my-5 rounded-xl border border-border bg-surface p-3.5 font-mono text-xs">
            <div class="flex flex-wrap items-center justify-between gap-2 border-b border-border pb-3">
              <div role="tablist" aria-label="KD Code agents" class="flex items-center gap-1">
                {
                  kdAgents.map((a, idx) => (
                    <button
                      type="button"
                      role="tab"
                      data-agent-tab={a.id}
                      data-branch={a.branch}
                      data-diff={a.diff}
                      data-time={a.time}
                      data-status={a.status}
                      data-log={a.log}
                      aria-selected={idx === 0 ? "true" : "false"}
                      class:list={[
                        "rounded-md px-2.5 py-1 text-xs font-medium transition-colors focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-accent",
                        idx === 0 ? "bg-accent text-accent-fg" : "text-fg-muted hover:bg-surface-elevated hover:text-fg",
                      ]}
                    >
                      {a.name}
                    </button>
                  ))
                }
              </div>
              <span data-kd-status class="text-[0.6875rem] text-accent">{kdAgents[0].status}</span>
            </div>

            <div class="mt-3 flex flex-wrap items-center justify-between gap-2 text-[0.75rem]">
              <span data-kd-branch class="font-medium text-fg">{kdAgents[0].branch}</span>
              <div class="flex items-center gap-3 tabular-nums">
                <span data-kd-diff class="text-status-open">{kdAgents[0].diff}</span>
                <span data-kd-time class="text-fg-muted">{kdAgents[0].time}</span>
              </div>
            </div>
            <p data-kd-log class="mt-2 truncate text-[0.75rem] text-fg-secondary">{kdAgents[0].log}</p>
          </div>

          <div class="mt-auto flex flex-wrap gap-1.5">
            {kdCode.tags.map((tag) => (
              <span class="rounded-md border border-border bg-surface px-2 py-0.5 font-mono text-[0.6875rem] text-fg-muted">
                {tag}
              </span>
            ))}
          </div>
        </article>

        <!-- Bento 2: Simple OTP Live 2FA Ring & Click-to-Copy -->
        <article
          data-reveal="pending"
          data-project-category={simpleOtp.category}
          class="spotlight-card flex flex-col rounded-2xl p-6 lg:col-span-5"
        >
          <div class="flex flex-wrap items-center justify-between gap-3">
            <div class="flex flex-wrap items-center gap-2">
              <span class="rounded-md border border-accent/25 bg-accent-soft/75 px-2 py-0.5 font-mono text-[0.6875rem] font-medium text-accent">
                {t("projects.badgeOpenSource")}
              </span>
              <span class="font-mono text-[0.6875rem] text-fg-muted">{simpleOtp.org} · {simpleOtp.period}</span>
            </div>
            <a
              href={simpleOtp.href}
              target="_blank"
              rel="noopener"
              class="font-mono text-xs text-fg-muted transition-colors hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
            >
              {t("home.simpleOtpGithub")}
            </a>
          </div>

          <h3 class="mt-3 text-xl font-semibold tracking-[-0.02em] text-fg">{simpleOtp.name}</h3>

          <p class="mt-2 text-sm leading-relaxed text-fg-secondary">{simpleOtp.summary}</p>

          <div data-totp-widget class="my-5 flex items-center justify-between gap-4 rounded-xl border border-border bg-surface p-4">
            <div>
              <p class="font-mono text-[0.6875rem] uppercase tracking-wider text-fg-muted">{t("home.otpLabel")}</p>
              <button
                type="button"
                data-totp-copy
                data-label-idle={t("home.otpCopy")}
                data-label-copied={t("home.otpCopied")}
                title={t("home.otpCopy")}
                class="group mt-1.5 flex items-baseline gap-2.5 text-left focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
              >
                <span data-totp-code class="font-mono text-2xl font-medium tracking-[0.18em] text-fg tabular-nums sm:text-[1.75rem]">
                  482 917
                </span>
                <span data-totp-copy-label class="rounded border border-border bg-surface-elevated px-1.5 py-0.5 font-mono text-[0.625rem] text-fg-muted transition-colors group-hover:border-border-strong group-hover:text-fg">
                  {t("home.otpCopy")}
                </span>
              </button>
            </div>

            <!-- Circular 30s SVG countdown -->
            <div class="relative grid size-12 shrink-0 place-items-center">
              <svg viewBox="0 0 36 36" class="size-12 -rotate-90" aria-hidden="true">
                <circle cx="18" cy="18" r="15" fill="none" stroke="var(--border-strong)" stroke-width="2.5"></circle>
                <circle
                  data-totp-ring
                  cx="18"
                  cy="18"
                  r="15"
                  fill="none"
                  stroke="var(--accent-vivid)"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-dasharray="94.25"
                  stroke-dashoffset="18"
                  class="transition-[stroke-dashoffset] duration-300 ease-linear"
                ></circle>
              </svg>
              <span data-totp-sec class="font-mono text-[0.6875rem] tabular-nums text-fg-secondary">24s</span>
            </div>
          </div>

          <div class="mt-auto flex flex-wrap gap-1.5">
            {simpleOtp.tags.map((tag) => (
              <span class="rounded-md border border-border bg-surface px-2 py-0.5 font-mono text-[0.6875rem] text-fg-muted">
                {tag}
              </span>
            ))}
          </div>
        </article>

        <!-- Real CV Production & Supporting Projects -->
        {
          otherProjects.map((p) => (
            <ProjectCard project={p} lang={lang} reveal class="lg:col-span-6" />
          ))
        }
      </div>
    </div>
  </section>

  <!-- Section: Interactive Career Experience Explorer (Structured Split-Pane on clean bg) -->
  <section aria-labelledby="home-experience" class="bg-bg">
    <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-20">
      <div class="mb-8 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <SectionPixelDecor variant="experience" class="mb-3" />
          <h2 id="home-experience" class="text-2xl font-semibold tracking-[-0.03em] text-fg sm:text-3xl">
            {t("home.experience")}
          </h2>
          <p class="mt-1 text-sm text-fg-secondary">{t("home.experienceDesc")}</p>
        </div>
        <a
          href={`${sectionPaths.about[lang]}#experience`}
          class="inline-flex items-center gap-1.5 font-mono text-xs text-fg-muted transition-colors hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
        >
          <span>{t("home.experienceAll")}</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>

      <ExperienceTimeline items={experienceList} lang={lang} variant="explorer" />
    </div>
  </section>
</div>

<script>
  let homeTimer: number | undefined;

  function formatTotp(step: number): string {
    let h = (step * 2654435761) >>> 0;
    h = ((h ^ (h >>> 16)) * 0x45d9f3b) >>> 0;
    const code = String(h % 1_000_000).padStart(6, "0");
    return `${code.slice(0, 3)} ${code.slice(3)}`;
  }

  function initReveals() {
    const reveals = [...document.querySelectorAll<HTMLElement>("[data-reveal]")];
    if (reveals.length === 0) return;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduceMotion || !("IntersectionObserver" in window)) {
      reveals.forEach((el) => (el.dataset.reveal = "visible"));
      return;
    }

    document.documentElement.classList.add("reveal-ready");
    const revealVisible = () => {
      const limit = window.innerHeight * 1.05;
      reveals.forEach((el) => {
        if (el.dataset.reveal === "visible") return;
        if (el.getBoundingClientRect().top <= limit) el.dataset.reveal = "visible";
      });
    };

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting || entry.boundingClientRect.top <= window.innerHeight) {
            (entry.target as HTMLElement).dataset.reveal = "visible";
            io.unobserve(entry.target);
          }
        });
      },
      { rootMargin: "80px 0px 80px 0px", threshold: 0.01 },
    );

    reveals.forEach((el) => io.observe(el));
    revealVisible();
    window.addEventListener("scroll", revealVisible, { passive: true });
    window.setTimeout(() => {
      reveals.forEach((el) => (el.dataset.reveal = "visible"));
      window.removeEventListener("scroll", revealVisible);
      io.disconnect();
    }, 1500);
  }

  function initMotionCraft() {
    clearInterval(homeTimer);

    const kdDemo = document.querySelector<HTMLElement>("[data-kd-demo]");
    if (kdDemo && !kdDemo.dataset.bound) {
      kdDemo.dataset.bound = "1";
      const tabs = kdDemo.querySelectorAll<HTMLButtonElement>("[data-agent-tab]");
      const statusEl = kdDemo.querySelector<HTMLElement>("[data-kd-status]")!;
      const branchEl = kdDemo.querySelector<HTMLElement>("[data-kd-branch]")!;
      const diffEl = kdDemo.querySelector<HTMLElement>("[data-kd-diff]")!;
      const timeEl = kdDemo.querySelector<HTMLElement>("[data-kd-time]")!;
      const logEl = kdDemo.querySelector<HTMLElement>("[data-kd-log]")!;

      tabs.forEach((tab) => {
        tab.addEventListener("click", () => {
          tabs.forEach((t) => {
            const active = t === tab;
            t.setAttribute("aria-selected", String(active));
            t.className = active
              ? "rounded-md bg-accent px-2.5 py-1 text-xs font-medium text-accent-fg transition-colors focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-accent"
              : "rounded-md px-2.5 py-1 text-xs font-medium text-fg-muted transition-colors hover:bg-surface-elevated hover:text-fg focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-accent";
          });
          statusEl.textContent = tab.dataset.status ?? "";
          branchEl.textContent = tab.dataset.branch ?? "";
          diffEl.textContent = tab.dataset.diff ?? "";
          timeEl.textContent = tab.dataset.time ?? "";
          logEl.textContent = tab.dataset.log ?? "";
        });
      });
    }

    const widget = document.querySelector<HTMLElement>("[data-totp-widget]");
    const codeEl = widget?.querySelector<HTMLElement>("[data-totp-code]");
    const secEl = widget?.querySelector<HTMLElement>("[data-totp-sec]");
    const ringEl = widget?.querySelector<SVGCircleElement>("[data-totp-ring]");
    const copyBtn = widget?.querySelector<HTMLButtonElement>("[data-totp-copy]");
    const copyLabel = widget?.querySelector<HTMLElement>("[data-totp-copy-label]");

    if (copyBtn && copyLabel && codeEl && !copyBtn.dataset.bound) {
      copyBtn.dataset.bound = "1";
      let resetTimer: number | undefined;
      copyBtn.addEventListener("click", async () => {
        const raw = (codeEl.textContent ?? "").replace(/\s+/g, "");
        try {
          await navigator.clipboard.writeText(raw);
        } catch {
          return;
        }
        copyLabel.textContent = copyBtn.dataset.labelCopied ?? "Copied";
        copyLabel.classList.add("text-accent", "border-accent");
        clearTimeout(resetTimer);
        resetTimer = window.setTimeout(() => {
          copyLabel.textContent = copyBtn.dataset.labelIdle ?? "Copy";
          copyLabel.classList.remove("text-accent", "border-accent");
        }, 1600);
      });
    }

    const CIRC = 2 * Math.PI * 15;

    const tickTotp = () => {
      if (!widget?.isConnected || !codeEl || !secEl || !ringEl) {
        clearInterval(homeTimer);
        return;
      }
      const nowSec = Math.floor(Date.now() / 1000);
      const step = Math.floor(nowSec / 30);
      const rem = 30 - (nowSec % 30);
      codeEl.textContent = formatTotp(step);
      secEl.textContent = `${rem}s`;
      ringEl.style.strokeDashoffset = String(CIRC * (1 - rem / 30));
    };

    if (widget) {
      tickTotp();
      homeTimer = window.setInterval(tickTotp, 1000);
    }
  }

  document.addEventListener("astro:page-load", () => {
    initReveals();
    if (typeof requestIdleCallback === "function") requestIdleCallback(initMotionCraft);
    else requestAnimationFrame(initMotionCraft);
  });
</script>
