---
// 404 page: crisp modern display "404" with the carved vermilion stamp & lục bát couplet.
import ThemeToggle from "./ThemeToggle.astro";
import { contentAnim } from "./transitions";
import { defaultLang, homePath, languages, sectionPaths, ui, type Lang, type Section } from "../i18n/ui";

const sections: Section[] = ["about", "blog", "contact"];
const versions = (Object.keys(languages) as Lang[]).map((lang) => {
  const t = (key: keyof (typeof ui)[typeof defaultLang]) => ui[lang][key];
  const [sealTop, sealBottom] = t("notFound.seal").split("|");
  return {
    lang,
    t,
    sealTop,
    sealBottom,
    links: [
      { label: t("nav.home"), href: homePath[lang] },
      ...sections.map((s) => ({ label: t(`nav.${s}`), href: sectionPaths[s][lang] })),
    ],
  };
});
const titles = Object.fromEntries(
  (Object.keys(languages) as Lang[]).map((l) => [l, `${ui[l]["notFound.seoTitle"]} · ${ui[l]["site.name"]}`]),
);
---

<main class="relative flex min-h-dvh flex-col items-center justify-center px-5 py-16 sm:px-6">
  <div class="absolute top-4 right-4 sm:top-6 sm:right-6">
    <ThemeToggle />
  </div>

  {
    versions.map(({ lang, t, sealTop, sealBottom, links }) => (
      <div
        data-nf-lang={lang}
        lang={lang}
        hidden={lang !== defaultLang}
        class="flex w-full max-w-xl flex-col items-center gap-6 text-center"
        transition:name={`content-404-${lang}`}
        transition:animate={contentAnim}
      >
        <div class="relative inline-flex items-start justify-center px-10">
          <p aria-hidden="true" class="text-[clamp(4.5rem,18vw,8rem)] font-bold leading-none tracking-[-0.05em] text-fg select-none">
            404
          </p>

          <button
            type="button"
            data-seal
            title={t("notFound.restamp")}
            aria-label={t("notFound.restamp")}
            class="seal absolute -top-1 right-0 grid size-14 cursor-pointer place-items-center rounded-md bg-[#b3322a] text-[0.6875rem] leading-tight font-semibold tracking-wider text-white uppercase focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent sm:size-16 sm:text-xs"
          >
            <span class="pointer-events-none flex flex-col">
              <span>{sealTop}</span>
              <span>{sealBottom}</span>
            </span>
          </button>
        </div>

        <h1 class="text-[clamp(1.625rem,5vw,2.25rem)] font-semibold tracking-[-0.03em] text-fg">
          <span class="sr-only">404 · </span>
          {t("notFound.title")}
        </h1>

        <blockquote class="text-lg leading-relaxed text-fg-secondary italic sm:text-xl">
          <p>{t("notFound.verse1")}</p>
          <p>{t("notFound.verse2")}</p>
        </blockquote>

        <div class="space-y-2 border-t border-border pt-6 text-sm text-fg-muted">
          <p>{t("notFound.lead")}</p>
          <p data-missing-wrap hidden>
            {t("notFound.path")}:
            <code data-missing-path class="ml-1 rounded-md border border-border bg-surface px-2 py-0.5 font-mono text-xs break-all text-accent" />
          </p>
        </div>

        <nav aria-label={t("notFound.suggest")} class="mt-2 flex flex-col items-center gap-3">
          <p class="font-mono text-[0.6875rem] tracking-[0.16em] text-fg-muted uppercase">{t("notFound.suggest")}</p>
          <ul class="flex flex-wrap justify-center gap-2">
            {
              links.map(({ label, href }) => (
                <li>
                  <a
                    href={href}
                    class="inline-flex rounded-full border border-border bg-surface-elevated px-4 py-2 text-sm font-medium text-fg transition-colors hover:border-border-strong hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
                  >
                    {label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    ))
  }

  <script is:inline define:vars={{ titles, defaultLang }}>
    (function () {
      var lang = /^\/en(\/|$)/.test(location.pathname) ? "en" : defaultLang;
      document.documentElement.lang = lang;
      document.title = titles[lang];
      document.querySelectorAll("[data-nf-lang]").forEach(function (el) {
        el.hidden = el.getAttribute("data-nf-lang") !== lang;
      });
    })();
  </script>
</main>

<script>
  function init() {
    let path = location.pathname;
    try {
      path = decodeURI(path);
    } catch {}
    document.querySelectorAll<HTMLElement>("[data-missing-path]").forEach((code) => (code.textContent = path));
    document.querySelectorAll<HTMLElement>("[data-missing-wrap]").forEach((wrap) => (wrap.hidden = false));

    document.querySelectorAll<HTMLElement>("[data-seal]").forEach((seal) =>
      seal.addEventListener("click", () => {
        seal.classList.remove("seal--again");
        void seal.offsetWidth;
        seal.classList.add("seal--again");
      }),
    );
  }

  document.addEventListener("astro:page-load", init);
</script>

<style>
  .seal {
    transform: rotate(-8deg);
    box-shadow:
      inset 0 0 0 2px #b3322a,
      inset 0 0 0 3px rgb(255 255 255 / 0.45);
  }

  @media (prefers-reduced-motion: no-preference) {
    .seal {
      animation: stamp 0.4s cubic-bezier(0.2, 1.3, 0.4, 1) 0.15s both;
    }

    .seal--again {
      animation: stamp 0.4s cubic-bezier(0.2, 1.3, 0.4, 1) both;
    }
  }

  @keyframes stamp {
    0% {
      opacity: 0;
      transform: rotate(-18deg) scale(1.8);
    }
    70% {
      opacity: 1;
      transform: rotate(-7deg) scale(0.95);
    }
    100% {
      opacity: 1;
      transform: rotate(-8deg) scale(1);
    }
  }
</style>
