---
import { contentAnim } from "./transitions";
import { languages, useTranslations, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
  links: Record<Lang, string>;
  /** Fixed to the top-right corner by default; pass a class to place it elsewhere. */
  class?: string;
}

const { lang, links, class: className = "fixed top-4 right-4 z-50 sm:top-6 sm:right-6" } = Astro.props;
const t = useTranslations(lang);
---

<nav
  aria-label={t("lang.switch")}
  transition:name="lang-switcher"
  transition:animate={contentAnim}
  class:list={[
    "flex items-center gap-1 rounded-full border border-paper/40 bg-ink p-1 pl-3 text-sm font-medium text-paper shadow-lg shadow-ink/30",
    className,
  ]}
>
  <svg
    aria-hidden="true"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="mr-1 size-4 text-rice"
  >
    <circle cx="12" cy="12" r="9"></circle>
    <path d="M3 12h18"></path>
    <path d="M12 3a14 14 0 0 1 0 18a14 14 0 0 1 0-18"></path>
  </svg>
  {
    (Object.keys(languages) as Lang[]).map((l) =>
      l === lang ? (
        <span aria-current="true" title={languages[l]} class="relative px-2.5 py-1 uppercase text-ink">
          <span aria-hidden="true" class="absolute inset-0 rounded-full bg-paper"></span>
          <span class="relative">{l}</span>
        </span>
      ) : (
        <a
          href={links[l]}
          hreflang={l}
          lang={l}
          title={languages[l]}
          class="rounded-full px-2.5 py-1 uppercase glow-hover hover:text-rice active:scale-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rice"
        >
          <span class="relative inline-block">{l}</span>
        </a>
      ),
    )
  }
</nav>
