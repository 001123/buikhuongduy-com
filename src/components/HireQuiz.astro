---
/** Mini game: a short recruiter quiz whose verdict is (unsurprisingly) "connect with Duy". */
import type { Lang } from "../i18n/ui";
import { email, socials } from "../data/profile";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

type Option = { text: string; score: number };
type Question = { q: string; options: Option[] };

const content: Record<
  Lang,
  {
    badge: string;
    title: string;
    intro: string;
    start: string;
    progress: string;
    resultLabel: string;
    results: { min: number; title: string; body: string }[];
    mailSubject: string;
    mailCta: string;
    linkedinCta: string;
    retry: string;
    followUp: string;
    questions: Question[];
  }
> = {
  vi: {
    badge: "Dành cho nhà tuyển dụng",
    title: "Duy có phù hợp với đội của bạn?",
    intro: "Bốn câu hỏi ngắn để bạn thấy kinh nghiệm của Duy khớp với nhu cầu của đội đến đâu.",
    start: "Bắt đầu",
    progress: "Câu {n}/{total}",
    resultLabel: "Độ phù hợp",
    results: [
      { min: 97, title: "Trời sinh một cặp!", body: "Đội của bạn và Duy hợp nhau như cơm với cá kho. Kết nối ngay trước khi người khác nhanh tay hơn nhé." },
      { min: 90, title: "Rất đáng để kết nối", body: "Dữ liệu cho thấy một buổi trò chuyện với Duy là khoản đầu tư sinh lời. Gửi lời chào thôi!" },
      { min: 0, title: "Vẫn nên kết nối", body: "Kể cả khi bạn chưa cần tuyển, một người bạn Frontend Lead biết AI thì chẳng bao giờ thừa." },
    ],
    mailSubject: "Cơ hội hợp tác cho Duy",
    mailCta: "Gửi email tuyển dụng",
    linkedinCta: "Kết nối LinkedIn",
    retry: "Làm lại",
    followUp: "Nếu bạn có câu hỏi khác, đừng ngại liên hệ với Duy qua email hoặc LinkedIn.",
    questions: [
      {
        q: "Đội của bạn đang cần gì nhất?",
        options: [
          { text: "Một Frontend Lead dẫn dắt đội", score: 3 },
          { text: "Người đưa AI vào quy trình làm việc", score: 3 },
          { text: "Ai đó vừa code giỏi vừa lo được DevOps", score: 3 },
          { text: "Tất cả những điều trên", score: 4 },
        ],
      },
      {
        q: "Codebase hiện tại của bạn trông thế nào?",
        options: [
          { text: "Sạch đẹp, chỉ cần người giữ chuẩn", score: 3 },
          { text: "Hơi rối, cần người dọn dẹp", score: 3 },
          { text: "Chưa có gì, làm lại từ đầu", score: 3 },
          { text: "Đừng hỏi…", score: 4 },
        ],
      },
      {
        q: "Bạn nghĩ gì về AI coding agent?",
        options: [
          { text: "Đang dùng hằng ngày", score: 3 },
          { text: "Muốn dùng nhưng chưa biết bắt đầu từ đâu", score: 4 },
          { text: "Còn nghi ngờ, cần người chứng minh", score: 3 },
        ],
      },
      {
        q: "Khi nào bạn cần người vào việc?",
        options: [
          { text: "Càng sớm càng tốt (lý tưởng là hôm qua)", score: 4 },
          { text: "Trong 1–2 tháng tới", score: 3 },
          { text: "Chưa gấp, muốn trò chuyện trước đã", score: 2 },
        ],
      },
    ],
  },
  en: {
    badge: "For hiring teams",
    title: "Am I the right fit for your team?",
    intro: "Four quick questions to see how well my experience matches what your team needs.",
    start: "Start",
    progress: "Question {n}/{total}",
    resultLabel: "Match",
    results: [
      { min: 97, title: "A match made in heaven!", body: "Your team and Duy go together like coffee and code reviews. Reach out before someone else does." },
      { min: 90, title: "Definitely worth a chat", body: "The data says a conversation with Duy is a high-return investment. Go say hi!" },
      { min: 0, title: "Still worth connecting", body: "Even if you're not hiring yet, an AI-native Frontend Lead in your network never hurts." },
    ],
    mailSubject: "An opportunity for Duy",
    mailCta: "Send a hiring email",
    linkedinCta: "Connect on LinkedIn",
    retry: "Retake",
    followUp: "If you have any other questions, feel free to reach out by email or on LinkedIn.",
    questions: [
      {
        q: "What does your team need most?",
        options: [
          { text: "A Frontend Lead to guide the team", score: 3 },
          { text: "Someone to bring AI into the workflow", score: 3 },
          { text: "A strong coder who can also handle DevOps", score: 3 },
          { text: "All of the above", score: 4 },
        ],
      },
      {
        q: "What does your codebase look like right now?",
        options: [
          { text: "Clean, just needs someone to keep it that way", score: 3 },
          { text: "A bit messy, needs a cleanup", score: 3 },
          { text: "Nothing yet, starting from scratch", score: 3 },
          { text: "Please don't ask…", score: 4 },
        ],
      },
      {
        q: "How do you feel about AI coding agents?",
        options: [
          { text: "We use them every day", score: 3 },
          { text: "We want to, but don't know where to start", score: 4 },
          { text: "Skeptical, someone needs to prove it", score: 3 },
        ],
      },
      {
        q: "When do you need someone on board?",
        options: [
          { text: "As soon as possible (yesterday, ideally)", score: 4 },
          { text: "Within the next 1–2 months", score: 3 },
          { text: "No rush, happy to chat first", score: 2 },
        ],
      },
    ],
  },
};

const c = content[lang];
const linkedin = socials.find((s) => s.icon === "linkedin")?.href ?? "";
const mailto = `mailto:${email}?subject=${encodeURIComponent(c.mailSubject)}`;
const data = {
  progress: c.progress,
  results: c.results,
  questions: c.questions,
};
---

<section data-hire-quiz class="not-prose mb-10 rounded-2xl border border-rice/30 bg-ink/40 p-5 backdrop-blur-md sm:p-7" aria-live="polite">
  <script type="application/json" data-quiz-data set:html={JSON.stringify(data)} />

  <div data-step="intro">
    <span class="inline-flex items-center gap-2 rounded-full border border-rice/40 px-3 py-1 text-xs leading-5 font-medium tracking-wider text-rice uppercase">
      <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-3.5">
        <rect x="3" y="7" width="18" height="13" rx="2" />
        <path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M3 13h18" />
      </svg>
      {c.badge}
    </span>
    <h2 class="mt-4 text-balance font-serif text-2xl font-semibold text-paper sm:text-3xl">{c.title}</h2>
    <p class="mt-2 text-pretty text-paper/75">{c.intro}</p>
    <button type="button" data-action="start" class="group mt-5 inline-flex items-center gap-2 rounded-full bg-rice px-5 py-2 font-medium text-ink glow-hover hover:brightness-110 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rice">
      {c.start}
      <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4 transition-transform group-hover:translate-x-0.5 motion-reduce:transition-none">
        <path d="M5 12h14M13 6l6 6-6 6" />
      </svg>
    </button>
  </div>

  <div data-step="question" hidden>
    <div class="flex items-center justify-between gap-3 text-sm text-paper/60">
      <span data-progress></span>
      <span aria-hidden="true" class="h-1 w-28 overflow-hidden rounded-full bg-paper/15">
        <span data-progress-bar class="block h-full w-0 bg-rice transition-[width] duration-300"></span>
      </span>
    </div>
    <h3 data-question class="mt-4 text-xl font-semibold text-paper"></h3>
    <div data-options class="mt-4 grid gap-2.5"></div>
  </div>

  <div data-step="result" hidden>
    <p class="text-sm tracking-wide text-paper/60 uppercase">{c.resultLabel}</p>
    <p class="mt-1 font-serif text-5xl font-semibold text-rice text-glow"><span data-score>0</span>%</p>
    <h3 data-result-title class="mt-4 text-xl font-semibold text-paper"></h3>
    <p data-result-body class="mt-2 text-pretty text-paper/75"></p>
    <div class="mt-6 flex flex-wrap gap-3">
      <a href={mailto} class="rounded-full bg-rice px-5 py-2 font-medium text-ink glow-hover hover:brightness-110 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rice">{c.mailCta}</a>
      <a href={linkedin} target="_blank" rel="noopener" class="rounded-full border border-paper/40 px-5 py-2 font-medium text-paper glow-hover hover:border-rice hover:text-rice focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rice">{c.linkedinCta}</a>
      <button type="button" data-action="retry" class="rounded-full px-4 py-2 text-paper/70 hover:text-rice focus-visible:outline-2 focus-visible:outline-rice">{c.retry}</button>
    </div>
    <p class="mt-5 text-sm text-pretty text-paper/60">{c.followUp}</p>
  </div>
</section>

<script>
  type Option = { text: string; score: number };
  type QuizData = {
    progress: string;
    mailto: string;
    results: { min: number; title: string; body: string }[];
    questions: { q: string; options: Option[] }[];
  };

  function init() {
    document.querySelectorAll<HTMLElement>("[data-hire-quiz]").forEach((root) => {
      if (root.dataset.ready) return;
      root.dataset.ready = "1";

      const data: QuizData = JSON.parse(root.querySelector("[data-quiz-data]")!.textContent!);
      const $ = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
      const steps = root.querySelectorAll<HTMLElement>("[data-step]");
      const show = (name: string) => steps.forEach((s) => (s.hidden = s.dataset.step !== name));

      const maxScore = data.questions.reduce((sum, q) => sum + Math.max(...q.options.map((o) => o.score)), 0);
      let index = 0;
      let score = 0;

      const renderQuestion = () => {
        const q = data.questions[index];
        const total = data.questions.length;
        $("[data-progress]").textContent = data.progress.replace("{n}", String(index + 1)).replace("{total}", String(total));
        $("[data-progress-bar]").style.width = `${(index / total) * 100}%`;
        $("[data-question]").textContent = q.q;
        const options = $("[data-options]");
        options.replaceChildren(
          ...q.options.map((o) => {
            const btn = document.createElement("button");
            btn.type = "button";
            btn.textContent = o.text;
            btn.className =
              "rounded-xl border border-paper/20 bg-paper/5 px-4 py-3 text-left text-paper glow-text-hover hover:border-rice/60 hover:bg-paper/10 hover:text-rice focus-visible:outline-2 focus-visible:outline-rice";
            btn.addEventListener("click", () => {
              score += o.score;
              index += 1;
              if (index < data.questions.length) renderQuestion();
              else renderResult();
            });
            return btn;
          }),
        );
        show("question");
        (options.firstElementChild as HTMLElement | null)?.focus();
      };

      const renderResult = () => {
        // Floor at 88%: every path leads to "you should connect".
        const percent = Math.round(88 + (score / maxScore) * 12);
        const result = data.results.find((r) => percent >= r.min)!;
        $("[data-result-title]").textContent = result.title;
        $("[data-result-body]").textContent = result.body;
        show("result");

        const out = $("[data-score]");
        const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (reduced) {
          out.textContent = String(percent);
          return;
        }
        const start = performance.now();
        const tick = (now: number) => {
          const t = Math.min((now - start) / 900, 1);
          out.textContent = String(Math.round(percent * (1 - (1 - t) ** 3)));
          if (t < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      };

      const begin = () => {
        index = 0;
        score = 0;
        renderQuestion();
      };

      $("[data-action='start']").addEventListener("click", begin);
      $("[data-action='retry']").addEventListener("click", begin);
    });
  }

  document.addEventListener("astro:page-load", init);
</script>
