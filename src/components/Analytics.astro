---
/**
 * Google Analytics 4, run off the main thread by Partytown so it does not affect Lighthouse scores.
 * Renders nothing unless PUBLIC_GA4_ID (e.g. G-XXXXXXXXXX) is set at build time.
 *
 * Page views with the ClientRouter: after each navigation Astro swaps these <head> scripts
 * (Partytown has rewritten their type, so they no longer match the incoming page), Partytown
 * runs them again in the worker, and `gtag('config')` sends a page_view for the new URL.
 * No manual page_view call is needed; adding one would double count.
 */
const id = import.meta.env.PUBLIC_GA4_ID;
---

{
  id && (
    <>
      <script type="text/partytown" src={`https://www.googletagmanager.com/gtag/js?id=${id}`} />
      <script type="text/partytown" define:vars={{ id }}>
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () {
          dataLayer.push(arguments);
        };
        gtag("js", new Date());
        gtag("config", id);
      </script>
    </>
  )
}
