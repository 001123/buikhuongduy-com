---
/** Author card at the end of a blog post: who wrote it, with links to /about and social profiles (E-E-A-T). */
import { Image } from "astro:assets";
import avatar from "../assets/avatar_cv.webp";
import ContactIcon from "./ContactIcon.astro";
import { socials } from "../data/profile";
import { getLang, sectionPaths, useTranslations } from "../i18n/ui";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
---

<aside
  class="not-prose mt-10 rounded-2xl border border-border bg-surface p-5 sm:p-6"
  aria-labelledby="author-heading"
>
  <div class="flex flex-wrap items-center justify-between gap-3">
    <div class="flex min-w-0 items-center gap-3.5">
      <a
        href={sectionPaths.about[lang]}
        class="shrink-0 rounded-full focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        tabindex="-1"
        aria-hidden="true"
      >
        <Image
          src={avatar}
          alt=""
          width={96}
          height={96}
          loading="lazy"
          class="size-12 rounded-full object-cover ring-1 ring-border-strong"
        />
      </a>
      <div class="min-w-0">
        <p class="font-mono text-[0.6875rem] font-medium uppercase tracking-[0.12em] text-accent">
          {t("blog.author.label")}
        </p>
        <h2 id="author-heading" class="mt-0.5 truncate text-base font-semibold tracking-tight text-fg">
          <a
            href={sectionPaths.about[lang]}
            class="transition-colors hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
            rel="author"
          >
            {t("site.name")}
          </a>
        </h2>
      </div>
    </div>

    <div class="flex items-center gap-1.5">
      <ul class="flex items-center gap-1.5">
        {
          socials.map((s) => (
            <li>
              <a
                href={s.href}
                target="_blank"
                rel="noopener me"
                aria-label={s.label}
                class="grid size-8 place-items-center rounded-full border border-border bg-surface-elevated text-fg-muted transition-colors hover:border-accent/60 hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
              >
                <ContactIcon name={s.icon} class="size-3.5" />
              </a>
            </li>
          ))
        }
      </ul>
      <a
        href={sectionPaths.about[lang]}
        class="inline-flex h-8 items-center rounded-full border border-border bg-surface-elevated px-3 text-xs font-medium text-fg transition-colors hover:border-accent hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      >
        {t("blog.author.more")}
      </a>
    </div>
  </div>

  <p class="mt-3.5 border-t border-border/70 pt-3.5 text-sm leading-relaxed text-fg-secondary">
    {t("blog.author.bio")}
  </p>
</aside>
