---
/** Author card at the end of a blog post: who wrote it, with links to /about and social profiles (E-E-A-T). */
import { Image } from "astro:assets";
import avatar from "../assets/avatar_cv.webp";
import ContactIcon from "./ContactIcon.astro";
import { socials } from "../data/profile";
import { getLang, sectionPaths, useTranslations } from "../i18n/ui";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
---

<aside class="not-prose mt-14 flex flex-col gap-4 rounded-xl border border-paper/15 bg-ink/40 p-5 sm:flex-row sm:items-start" aria-labelledby="author-heading">
  <a href={sectionPaths.about[lang]} class="shrink-0 self-start rounded-full glow-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rice" tabindex="-1" aria-hidden="true">
    <Image src={avatar} alt="" width={128} height={128} loading="lazy" class="size-16 rounded-full border border-paper/20 object-cover" />
  </a>
  <div class="min-w-0">
    <p class="text-xs uppercase tracking-wider text-paper/55">{t("blog.author.label")}</p>
    <h2 id="author-heading" class="mt-0.5 font-serif text-lg font-semibold text-paper">
      <a href={sectionPaths.about[lang]} class="hover:text-rice focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rice" rel="author">{t("site.name")}</a>
    </h2>
    <p class="mt-1 text-sm text-paper/70">{t("blog.author.bio")}</p>
    <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
      <a href={sectionPaths.about[lang]} class="text-rice hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rice">{t("blog.author.more")}</a>
      <ul class="flex items-center gap-3">
        {socials.map((s) => (
          <li>
            <a href={s.href} target="_blank" rel="noopener me" aria-label={s.label} class="block text-paper/60 hover:text-rice focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rice">
              <ContactIcon name={s.icon} class="size-4" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</aside>
