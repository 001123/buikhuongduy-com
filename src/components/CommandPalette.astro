---
import { cvUrl, email } from "../data/profile";
import { homePath, languages, sectionPaths, useTranslations, type Lang } from "../i18n/ui";
import { searchIndexPath } from "../lib/search";

interface Props {
  lang: Lang;
  links: Record<Lang, string>;
}

const { lang, links } = Astro.props;
const t = useTranslations(lang);
const otherLang = (Object.keys(languages) as Lang[]).find((l) => l !== lang)!;

const actions = [
  { id: "home", label: t("nav.home"), group: t("cmd.actions"), href: homePath[lang], hint: "/" },
  { id: "about", label: t("nav.about"), group: t("cmd.actions"), href: sectionPaths.about[lang], hint: "" },
  { id: "blog", label: t("nav.blog"), group: t("cmd.actions"), href: sectionPaths.blog[lang], hint: "" },
  { id: "contact", label: t("nav.contact"), group: t("cmd.actions"), href: sectionPaths.contact[lang], hint: "" },
  { id: "cv", label: t("cmd.openCv"), group: t("cmd.actions"), href: cvUrl, external: true, hint: "↗" },
  { id: "theme", label: t("cmd.toggleTheme"), group: t("cmd.actions"), action: "theme", hint: "◐" },
  { id: "lang", label: t("cmd.switchLang"), group: t("cmd.actions"), href: links[otherLang], hint: otherLang.toUpperCase() },
  { id: "email", label: t("cmd.copyEmail"), group: t("cmd.actions"), action: "copy-email", value: email, hint: email },
];
---

<dialog
  id="command-palette"
  aria-label={t("cmd.open")}
  data-index={searchIndexPath(lang)}
  data-search-href={sectionPaths.search[lang]}
  data-actions={JSON.stringify(actions)}
  data-label-actions={t("cmd.actions")}
  data-label-posts={t("cmd.posts")}
  data-label-empty={t("cmd.empty")}
  data-label-full={t("cmd.fullSearch")}
  class="m-auto w-[min(92vw,36rem)] max-w-none bg-transparent p-0 text-fg backdrop:bg-black/50 backdrop:backdrop-blur-[2px] open:flex open:flex-col"
>
  <div class="flex w-full flex-col overflow-hidden rounded-2xl border border-border-strong bg-surface-elevated text-fg shadow-2xl">
    <div class="flex items-center gap-3 border-b border-border px-4 py-3">
      <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4 shrink-0 text-fg-muted">
        <circle cx="11" cy="11" r="7"></circle>
        <path d="m20 20-3.5-3.5"></path>
      </svg>
      <input
        type="search"
        data-cmd-input
        autocomplete="off"
        spellcheck="false"
        placeholder={t("cmd.placeholder")}
        aria-label={t("cmd.placeholder")}
        class="min-w-0 flex-1 bg-transparent text-sm text-fg outline-none placeholder:text-fg-muted [&::-webkit-search-cancel-button]:hidden"
      />
      <kbd class="rounded border border-border bg-surface px-1.5 py-0.5 font-mono text-[0.6875rem] text-fg-muted">Esc</kbd>
    </div>

    <div data-cmd-list role="listbox" class="max-h-[min(60dvh,24rem)] overflow-y-auto p-2"></div>

    <div class="flex items-center justify-between border-t border-border bg-surface px-4 py-2 font-mono text-[0.6875rem] text-fg-muted">
      <span>{t("cmd.hint")}</span>
      <span data-cmd-status aria-live="polite"></span>
    </div>
  </div>
</dialog>

<style>
  #command-palette[open] {
    animation: cmd-in 150ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  @keyframes cmd-in {
    from {
      opacity: 0;
      transform: translateY(-6px) scale(0.98);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #command-palette[open] {
      animation: none;
    }
  }
</style>

<script>
  interface SearchDoc {
    url: string;
    title: string;
    description: string;
    category?: string;
    tags: string[];
    date: string;
    dateLabel: string;
  }

  interface ActionItem {
    id: string;
    label: string;
    group: string;
    href?: string;
    external?: boolean;
    action?: string;
    value?: string;
    hint?: string;
    sub?: string;
  }

  const indexCache = new Map<string, Promise<SearchDoc[]>>();

  function fold(text: string): string {
    return text.normalize("NFC").toLowerCase().normalize("NFD").replace(/\p{M}/gu, "").replace(/đ/g, "d");
  }

  function fetchDocs(url: string): Promise<SearchDoc[]> {
    let pending = indexCache.get(url);
    if (!pending) {
      pending = fetch(url)
        .then((r) => (r.ok ? (r.json() as Promise<SearchDoc[]>) : []))
        .catch(() => []);
      indexCache.set(url, pending);
    }
    return pending;
  }

  function setupPalette() {
    const dialog = document.querySelector<HTMLDialogElement>("#command-palette");
    if (!dialog || dialog.dataset.bound) return;
    dialog.dataset.bound = "1";

    const input = dialog.querySelector<HTMLInputElement>("[data-cmd-input]")!;
    const list = dialog.querySelector<HTMLElement>("[data-cmd-list]")!;
    const status = dialog.querySelector<HTMLElement>("[data-cmd-status]")!;
    const actions: ActionItem[] = JSON.parse(dialog.dataset.actions ?? "[]");
    const indexUrl = dialog.dataset.index ?? "/search/index.json";
    const searchHref = dialog.dataset.searchHref ?? "/search/";
    const labelPosts = dialog.dataset.labelPosts ?? "Articles";
    const labelEmpty = dialog.dataset.labelEmpty ?? "No matching results.";
    const labelFull = dialog.dataset.labelFull ?? "Open full search";

    let docs: SearchDoc[] = [];
    let items: ActionItem[] = [];
    let activeIdx = 0;

    function runItem(item: ActionItem) {
      dialog!.close();
      if (item.action === "theme") {
        document.querySelector<HTMLButtonElement>("[data-theme-toggle]")?.click();
        return;
      }
      if (item.action === "copy-email" && item.value) {
        navigator.clipboard?.writeText(item.value).catch(() => {});
        return;
      }
      if (item.href) {
        if (item.external) {
          window.open(item.href, "_blank", "noopener");
        } else {
          const a = document.createElement("a");
          a.href = item.href;
          document.body.append(a);
          a.click();
          a.remove();
        }
      }
    }

    function setActive(idx: number) {
      const buttons = list.querySelectorAll<HTMLButtonElement>("[data-cmd-idx]");
      if (buttons.length === 0) return;
      activeIdx = (idx + buttons.length) % buttons.length;
      buttons.forEach((b, i) => {
        const on = i === activeIdx;
        b.dataset.active = on ? "true" : "false";
        b.className = on
          ? "flex w-full items-center justify-between gap-3 rounded-lg bg-accent-soft px-3 py-2 text-left text-sm text-fg"
          : "flex w-full items-center justify-between gap-3 rounded-lg px-3 py-2 text-left text-sm text-fg-secondary hover:bg-surface";
        if (on) b.scrollIntoView({ block: "nearest" });
      });
    }

    function render(query: string) {
      const q = fold(query.trim());
      const words = q.split(/\s+/).filter(Boolean);

      const matchedActions = words.length
        ? actions.filter((a) => words.every((w) => fold(a.label).includes(w) || fold(a.hint ?? "").includes(w)))
        : actions;

      const matchedPosts: ActionItem[] = docs
        .filter((d) => {
          if (!words.length) return true;
          const hay = fold(`${d.title} ${d.description} ${d.category ?? ""} ${d.tags.join(" ")}`);
          return words.every((w) => hay.includes(w));
        })
        .slice(0, words.length ? 8 : 5)
        .map((d) => ({
          id: d.url,
          label: d.title,
          group: labelPosts,
          href: d.url,
          hint: d.category ?? d.dateLabel,
          sub: d.dateLabel,
        }));

      items = [...matchedActions, ...matchedPosts];
      if (words.length) {
        items.push({
          id: "full-search",
          label: `${labelFull}: “${query.trim()}”`,
          group: "",
          href: `${searchHref}?q=${encodeURIComponent(query.trim())}`,
          hint: "↵",
        });
      }

      list.replaceChildren();
      if (items.length === 0) {
        const empty = document.createElement("p");
        empty.className = "px-3 py-6 text-center text-sm text-fg-muted";
        empty.textContent = labelEmpty;
        list.append(empty);
        return;
      }

      let lastGroup = "";
      items.forEach((item, idx) => {
        if (item.group && item.group !== lastGroup) {
          lastGroup = item.group;
          const heading = document.createElement("p");
          heading.className = "px-3 pt-2.5 pb-1 font-mono text-[0.6875rem] uppercase tracking-[0.12em] text-fg-muted";
          heading.textContent = item.group;
          list.append(heading);
        }

        const btn = document.createElement("button");
        btn.type = "button";
        btn.role = "option";
        btn.dataset.cmdIdx = String(idx);

        const left = document.createElement("span");
        left.className = "min-w-0 truncate font-medium";
        left.textContent = item.label;

        const right = document.createElement("span");
        right.className = "shrink-0 font-mono text-[0.75rem] text-fg-muted";
        right.textContent = item.hint ?? "";

        btn.append(left, right);
        btn.addEventListener("click", () => runItem(item));
        btn.addEventListener("pointerenter", () => setActive(idx));
        list.append(btn);
      });

      activeIdx = 0;
      setActive(0);
      status.textContent = `${items.length}`;
    }

    async function openPalette() {
      if (dialog!.open) return;
      input.value = "";
      dialog!.showModal();
      render("");
      input.focus();
      if (docs.length === 0) {
        docs = await fetchDocs(indexUrl);
        if (dialog!.open) render(input.value);
      }
    }

    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog.close();
    });

    input.addEventListener("input", () => render(input.value));
    input.addEventListener("keydown", (e) => {
      if (e.key === "ArrowDown") {
        e.preventDefault();
        setActive(activeIdx + 1);
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        setActive(activeIdx - 1);
      } else if (e.key === "Enter" && items[activeIdx]) {
        e.preventDefault();
        runItem(items[activeIdx]);
      }
    });

    (window as Window & { __openCmdPalette?: () => void }).__openCmdPalette = openPalette;
  }

  const win = window as Window & { __cmdKeyBound?: boolean; __openCmdPalette?: () => void };
  if (!win.__cmdKeyBound) {
    win.__cmdKeyBound = true;
    document.addEventListener("keydown", (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
        e.preventDefault();
        win.__openCmdPalette?.();
        return;
      }
      if (e.key === "/" && !e.metaKey && !e.ctrlKey && !e.altKey && !e.defaultPrevented) {
        const target = e.target as HTMLElement | null;
        if (target?.closest("input, textarea, select, [contenteditable]:not([contenteditable='false'])")) return;
        const pageSearch = [...document.querySelectorAll<HTMLInputElement>("[data-search-input]")].find((el) => el.offsetParent !== null);
        if (pageSearch) {
          e.preventDefault();
          pageSearch.focus();
          pageSearch.select();
          return;
        }
        if (win.__openCmdPalette) {
          e.preventDefault();
          win.__openCmdPalette();
        }
      }
    });

    document.addEventListener("click", (e) => {
      if (!(e.target instanceof Element)) return;
      if (e.target.closest("[data-cmd-open]")) {
        e.preventDefault();
        win.__openCmdPalette?.();
      }
    });
  }

  document.addEventListener("astro:page-load", setupPalette);
</script>
