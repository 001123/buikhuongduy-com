---
import type { ExperienceItem } from "../data/experience";
import { sectionPaths, useTranslations, type Lang } from "../i18n/ui";

interface Props {
  items: ExperienceItem[];
  lang: Lang;
  variant?: "timeline" | "explorer";
  showAvailability?: boolean;
}

const { items, lang, variant = "timeline", showAvailability = false } = Astro.props;
const t = useTranslations(lang);
const isVi = lang === "vi";

function formatMonth(date: Date, l: string) {
  return l === "vi"
    ? `${String(date.getMonth() + 1).padStart(2, "0")}/${date.getFullYear()}`
    : date.toLocaleDateString("en-US", { month: "short", year: "numeric" });
}
const now = new Date();
const buildMonth = {
  label: formatMonth(now, lang),
  iso: `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, "0")}`,
};

const labels = {
  detailed: isVi ? "Đầy đủ" : "Detailed",
  compact: isVi ? "Tóm tắt" : "Compact",
  contributions: isVi ? "Đóng góp chính" : "Key contributions",
  outcomes: isVi ? "Kết quả" : "Impact & results",
  viewMode: isVi ? "Chế độ hiển thị kinh nghiệm" : "Experience display mode",
  roleList: isVi ? "Danh sách kinh nghiệm" : "Career history",
};
---

{
  variant === "timeline" ? (
    <div data-exp-timeline data-exp-mode="detailed" class="not-prose space-y-5">
      <div class="flex flex-wrap items-center justify-between gap-3">
        {showAvailability ? (
          <div class="flex flex-wrap items-center gap-2.5 rounded-full border border-border bg-surface-elevated px-3.5 py-1.5 text-xs">
            <span aria-hidden="true" class="relative flex size-2">
              <span class="status-ping-ring absolute inline-flex h-full w-full rounded-full bg-status-open opacity-75"></span>
              <span class="relative inline-flex size-2 rounded-full bg-status-open"></span>
            </span>
            <time data-current-month data-lang={lang} datetime={buildMonth.iso} class="font-mono text-fg-muted tabular-nums">
              {buildMonth.label}
            </time>
            <span aria-hidden="true" class="text-border-strong">·</span>
            <span class="font-medium text-fg">{t("about.hire")}</span>
            <a
              href={sectionPaths.contact[lang]}
              class="font-medium text-accent underline decoration-accent/40 underline-offset-4 transition-colors hover:text-accent-hover hover:decoration-accent"
            >
              {t("about.hireLink")} →
            </a>
          </div>
        ) : (
          <div></div>
        )}

        <div
          role="group"
          aria-label={labels.viewMode}
          class="inline-flex items-center rounded-lg border border-border bg-surface-elevated p-0.5 font-mono text-[0.6875rem]"
        >
          <button
            type="button"
            data-exp-toggle="detailed"
            aria-pressed="true"
            class="rounded-md px-2.5 py-1 text-fg-muted transition-colors hover:text-fg aria-pressed:bg-surface aria-pressed:font-medium aria-pressed:text-fg aria-pressed:shadow-2xs focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-accent"
          >
            {labels.detailed}
          </button>
          <button
            type="button"
            data-exp-toggle="compact"
            aria-pressed="false"
            class="rounded-md px-2.5 py-1 text-fg-muted transition-colors hover:text-fg aria-pressed:bg-surface aria-pressed:font-medium aria-pressed:text-fg aria-pressed:shadow-2xs focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-accent"
          >
            {labels.compact}
          </button>
        </div>
      </div>

      <ol class="relative space-y-5 before:absolute before:top-3 before:bottom-3 before:left-[0.4375rem] before:w-px before:bg-border sm:before:left-[0.5625rem]">
        {items.map((job) => (
          <li class="relative pl-7 sm:pl-9">
            <span
              aria-hidden="true"
              class:list={[
                "absolute top-6 left-0 flex size-3.5 items-center justify-center rounded-full border sm:size-4.5",
                job.isCurrent
                  ? "border-accent bg-accent-soft ring-4 ring-bg"
                  : "border-border-strong bg-surface-elevated ring-4 ring-bg",
              ]}
            >
              <span
                class:list={[
                  "size-1.5 rounded-full",
                  job.isCurrent ? "bg-accent-vivid" : "bg-fg-muted",
                ]}
              ></span>
            </span>

            <article class="spotlight-card rounded-2xl p-5 sm:p-6">
              <div class="flex flex-wrap items-start justify-between gap-2.5">
                <div class="min-w-0">
                  <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
                    <span class="font-mono text-xs font-medium text-accent tabular-nums">{job.period}</span>
                    <span aria-hidden="true" class="text-border-strong">·</span>
                    <span class="font-mono text-[0.6875rem] text-fg-muted">{job.duration}</span>
                  </div>

                  <h3 class="mt-1.5 text-base font-semibold tracking-[-0.015em] text-fg sm:text-lg">
                    <span>{job.role}</span>
                    <span class="mx-1.5 font-normal text-fg-muted">·</span>
                    {job.orgUrl ? (
                      <a
                        href={job.orgUrl}
                        target="_blank"
                        rel="noopener"
                        class="inline-flex items-center gap-1 text-fg-secondary underline decoration-border-strong underline-offset-4 transition-colors hover:text-accent hover:decoration-accent"
                      >
                        <span>{job.org}</span>
                        <span aria-hidden="true" class="font-mono text-xs">↗</span>
                      </a>
                    ) : (
                      <span class="text-fg-secondary">{job.org}</span>
                    )}
                  </h3>
                </div>

                <div class="flex flex-wrap items-center gap-1.5 font-mono text-[0.6875rem] text-fg-muted">
                  <span class="rounded-md border border-border bg-surface px-2 py-0.5">{job.teamSize}</span>
                  {job.workMode && job.workMode !== job.teamSize && (
                    <span class="rounded-md border border-border bg-surface px-2 py-0.5">{job.workMode}</span>
                  )}
                </div>
              </div>

              <p class="mt-3 text-sm leading-relaxed text-fg-secondary">{job.summary}</p>

              {job.metrics.length > 0 && (
                <div class="mt-3.5 flex flex-wrap gap-1.5">
                  {job.metrics.map((metric) => (
                    <span class="inline-flex items-center rounded-full border border-accent/20 bg-accent-soft/75 px-2.5 py-0.5 font-mono text-[0.6875rem] font-medium text-accent">
                      {metric}
                    </span>
                  ))}
                </div>
              )}

              <div data-exp-details class="mt-4 space-y-4 border-t border-border pt-4">
                <div>
                  <p class="font-mono text-[0.6875rem] font-medium uppercase tracking-[0.08em] text-fg-muted">
                    {labels.contributions}
                  </p>
                  <ul class="mt-2 space-y-1.5 text-sm leading-relaxed text-fg-secondary">
                    {job.highlights.map((item) => (
                      <li class="flex gap-2.5">
                        <span aria-hidden="true" class="mt-2 size-1.5 shrink-0 rounded-full bg-border-strong"></span>
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                {job.outcomes.length > 0 && (
                  <div class="rounded-xl border border-border bg-surface/70 p-3.5">
                    <p class="font-mono text-[0.6875rem] font-medium uppercase tracking-[0.08em] text-fg-muted">
                      {labels.outcomes}
                    </p>
                    <ul class="mt-2 space-y-1.5 text-sm leading-relaxed text-fg">
                      {job.outcomes.map((outcome) => (
                        <li class="flex gap-2">
                          <svg
                            aria-hidden="true"
                            viewBox="0 0 16 16"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.8"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class="mt-1 size-3.5 shrink-0 text-status-open"
                          >
                            <path d="M3.5 8.5 6.5 11.5 12.5 4.5" />
                          </svg>
                          <span>{outcome}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </div>

              <div class="mt-4 flex flex-wrap gap-1.5">
                {job.tech.map((tech) => (
                  <span class="rounded-md border border-border bg-surface px-2 py-0.5 font-mono text-[0.6875rem] text-fg-muted">
                    {tech}
                  </span>
                ))}
              </div>
            </article>
          </li>
        ))}
      </ol>
    </div>
  ) : (
    <div
      data-exp-explorer
      class="grid overflow-hidden rounded-2xl border border-border-strong bg-surface-elevated shadow-[0_1px_2px_rgba(0,0,0,0.03)] dark:shadow-none lg:grid-cols-[19.5rem_1fr]"
    >
      <!-- Role Selector Rail (Recessed left pane) -->
      <div
        role="tablist"
        aria-label={labels.roleList}
        class="flex gap-1.5 overflow-x-auto border-b border-border bg-surface/75 p-2.5 lg:flex-col lg:gap-1 lg:overflow-visible lg:border-r lg:border-b-0 lg:p-3"
      >
        {items.map((job, idx) => (
          <button
            type="button"
            role="tab"
            id={`exp-tab-${job.id}`}
            aria-controls={`exp-panel-${job.id}`}
            aria-selected={idx === 0 ? "true" : "false"}
            data-exp-tab={job.id}
            class:list={[
              "exp-tab group relative flex min-w-[13.5rem] shrink-0 flex-col rounded-xl border p-3.5 text-left transition-all duration-150 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent lg:min-w-0",
              idx === 0
                ? "border-border-strong bg-surface-elevated shadow-2xs"
                : "border-transparent bg-transparent hover:border-border hover:bg-surface-elevated/60",
            ]}
          >
            <div class="flex w-full items-center justify-between gap-2">
              <span class="inline-flex items-center gap-1.5 font-mono text-[0.6875rem] tabular-nums text-fg-muted">
                {job.isCurrent && (
                  <span aria-hidden="true" class="size-1.5 rounded-full bg-status-open"></span>
                )}
                <span>{job.period}</span>
              </span>
              <span class="font-mono text-[0.625rem] text-fg-muted">{job.duration}</span>
            </div>
            <span class="mt-1.5 text-sm font-semibold text-fg transition-colors group-aria-selected:text-accent">
              {job.role}
            </span>
            <span class="mt-0.5 truncate text-xs text-fg-secondary">{job.org}</span>
          </button>
        ))}
      </div>

      <!-- Selected Role Detail Stage (Clean elevated right pane) -->
      <div class="min-w-0 bg-surface-elevated">
        {items.map((job, idx) => (
          <article
            role="tabpanel"
            id={`exp-panel-${job.id}`}
            aria-labelledby={`exp-tab-${job.id}`}
            data-exp-panel={job.id}
            class:list={[
              "p-6 sm:p-8",
              idx !== 0 && "hidden",
            ]}
          >
            <div class="flex flex-wrap items-start justify-between gap-3 border-b border-border pb-4">
              <div>
                <div class="flex flex-wrap items-center gap-2 font-mono text-xs text-accent tabular-nums">
                  {job.isCurrent && (
                    <span class="inline-flex items-center gap-1.5 rounded-full border border-status-open/30 bg-status-open/10 px-2 py-0.5 text-[0.6875rem] font-medium text-status-open">
                      <span aria-hidden="true" class="size-1.5 rounded-full bg-status-open"></span>
                      {job.duration}
                    </span>
                  )}
                  <span>{job.period}</span>
                  {!job.isCurrent && (
                    <>
                      <span aria-hidden="true" class="text-border-strong">·</span>
                      <span class="text-fg-muted">{job.duration}</span>
                    </>
                  )}
                </div>

                <h3 class="mt-2 text-xl font-semibold tracking-[-0.02em] text-fg">
                  <span>{job.role}</span>
                  <span class="mx-1.5 font-normal text-fg-muted">·</span>
                  {job.orgUrl ? (
                    <a
                      href={job.orgUrl}
                      target="_blank"
                      rel="noopener"
                      class="inline-flex items-center gap-1 text-fg-secondary underline decoration-border-strong underline-offset-4 transition-colors hover:text-accent hover:decoration-accent"
                    >
                      <span>{job.org}</span>
                      <span aria-hidden="true" class="font-mono text-xs">↗</span>
                    </a>
                  ) : (
                    <span class="text-fg-secondary">{job.org}</span>
                  )}
                </h3>
              </div>

              <div class="flex flex-wrap items-center gap-1.5 font-mono text-[0.6875rem] text-fg-muted">
                <span class="rounded-md border border-border bg-surface px-2.5 py-1">{job.teamSize}</span>
                {job.workMode && job.workMode !== job.teamSize && (
                  <span class="rounded-md border border-border bg-surface px-2.5 py-1">{job.workMode}</span>
                )}
              </div>
            </div>

            <p class="mt-4 text-sm leading-relaxed text-fg-secondary sm:text-[0.9375rem]">{job.summary}</p>

            {job.metrics.length > 0 && (
              <div class="mt-4 flex flex-wrap gap-1.5">
                {job.metrics.map((metric) => (
                  <span class="inline-flex items-center rounded-full border border-accent/20 bg-accent-soft/75 px-2.5 py-0.5 font-mono text-[0.6875rem] font-medium text-accent">
                    {metric}
                  </span>
                ))}
              </div>
            )}

            <div class="mt-5 grid gap-4 sm:grid-cols-1">
              <div>
                <p class="font-mono text-[0.6875rem] font-medium uppercase tracking-[0.08em] text-fg-muted">
                  {labels.contributions}
                </p>
                <ul class="mt-2 space-y-2 text-sm leading-relaxed text-fg-secondary">
                  {job.highlights.map((item) => (
                    <li class="flex gap-2.5">
                      <span aria-hidden="true" class="mt-2 size-1.5 shrink-0 rounded-full bg-accent-vivid"></span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>

              {job.outcomes.length > 0 && (
                <div class="rounded-xl border border-border bg-surface/75 p-4">
                  <p class="font-mono text-[0.6875rem] font-medium uppercase tracking-[0.08em] text-fg-muted">
                    {labels.outcomes}
                  </p>
                  <ul class="mt-2 space-y-1.5 text-sm leading-relaxed text-fg">
                    {job.outcomes.map((outcome) => (
                      <li class="flex gap-2">
                        <svg
                          aria-hidden="true"
                          viewBox="0 0 16 16"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.8"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          class="mt-1 size-3.5 shrink-0 text-status-open"
                        >
                          <path d="M3.5 8.5 6.5 11.5 12.5 4.5" />
                        </svg>
                        <span>{outcome}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>

            <div class="mt-5 flex flex-wrap gap-1.5 border-t border-border pt-4">
              {job.tech.map((tech) => (
                <span class="rounded-md border border-border bg-surface px-2 py-0.5 font-mono text-[0.6875rem] text-fg-muted">
                  {tech}
                </span>
              ))}
            </div>
          </article>
        ))}
      </div>
    </div>
  )
}

<style>
  [data-exp-timeline][data-exp-mode="compact"] [data-exp-details] {
    display: none;
  }
</style>

<script>
  function initExperienceUI() {
    document.querySelectorAll<HTMLElement>("[data-exp-timeline]").forEach((root) => {
      if (root.dataset.expBound) return;
      root.dataset.expBound = "1";
      const buttons = root.querySelectorAll<HTMLButtonElement>("[data-exp-toggle]");
      buttons.forEach((btn) => {
        btn.addEventListener("click", () => {
          const mode = btn.dataset.expToggle ?? "detailed";
          root.dataset.expMode = mode;
          buttons.forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
        });
      });
    });

    document.querySelectorAll<HTMLElement>("[data-exp-explorer]").forEach((root) => {
      if (root.dataset.expBound) return;
      root.dataset.expBound = "1";
      const tabs = root.querySelectorAll<HTMLButtonElement>("[data-exp-tab]");
      const panels = root.querySelectorAll<HTMLElement>("[data-exp-panel]");

      tabs.forEach((tab) => {
        tab.addEventListener("click", () => {
          const targetId = tab.dataset.expTab;
          tabs.forEach((t) => {
            const active = t === tab;
            t.setAttribute("aria-selected", String(active));
            t.classList.toggle("border-border-strong", active);
            t.classList.toggle("bg-surface-elevated", active);
            t.classList.toggle("shadow-2xs", active);
            t.classList.toggle("border-transparent", !active);
            t.classList.toggle("bg-transparent", !active);
          });
          panels.forEach((panel) => {
            panel.classList.toggle("hidden", panel.dataset.expPanel !== targetId);
          });
        });
      });
    });
  }

  initExperienceUI();
  document.addEventListener("astro:page-load", initExperienceUI);
</script>
