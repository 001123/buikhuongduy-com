        <rect x="15" y="10" width="6" height="1" fill="var(--fg-muted)" />
        <rect x="15" y="12" width="5" height="1" fill="var(--fg-muted)" />
        <rect x="15" y="14" width="2" height="1" fill="var(--status-open)" class="pixel-led-pulse" />
        <rect x="18" y="14" width="4" height="1" fill="var(--border-strong)" />

        {/* Developer Monitor + Blinking Cursor */}
        <rect x="31" y="4" width="20" height="11" fill="var(--fg)" />
        <rect x="32" y="5" width="18" height="9" fill="var(--surface-elevated)" />
        <rect x="32" y="5" width="18" height="2" fill="var(--surface)" />
        <rect x="33" y="5" width="1" height="1" fill="var(--accent-vivid)" />
        <rect x="35" y="5" width="1" height="1" fill="var(--status-open)" />
