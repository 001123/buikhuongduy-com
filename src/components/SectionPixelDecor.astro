---
interface Props {
  variant: "about" | "writing" | "projects" | "experience" | "contact" | "footer";
  class?: string;
}

const { variant, class: className = "" } = Astro.props;
---

<div aria-hidden="true" class:list={["pixel-decor inline-flex select-none items-end", className]}>
  {
    variant === "about" && (
      <svg
        viewBox="0 0 96 20"
        width="192"
        height="40"
        fill="none"
        shape-rendering="crispEdges"
        class="h-9 w-auto sm:h-10"
      >
        {/* Ground shelf */}
        <rect x="2" y="18" width="90" height="1" fill="var(--border-strong)" />
        <rect x="0" y="18" width="1" height="1" fill="var(--border)" />
        <rect x="93" y="18" width="1" height="1" fill="var(--border)" />

        {/* Profile ID Badge */}
        <rect x="13" y="3" width="4" height="1" fill="var(--fg-muted)" />
        <rect x="14" y="4" width="2" height="1" fill="var(--accent-vivid)" />
        <rect x="5" y="5" width="20" height="13" fill="var(--fg)" />
        <rect x="6" y="6" width="18" height="11" fill="var(--surface-elevated)" />
