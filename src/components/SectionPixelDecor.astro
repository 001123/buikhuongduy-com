---
interface Props {
  variant: "writing" | "projects" | "experience" | "footer";
  class?: string;
}

const { variant, class: className = "" } = Astro.props;
---

<div aria-hidden="true" class:list={["pixel-decor inline-flex select-none items-end", className]}>
  {
    variant === "writing" && (
      <svg
        viewBox="0 0 96 20"
        width="192"
        height="40"
        fill="none"
        shape-rendering="crispEdges"
        class="h-9 w-auto sm:h-10"
      >
        {/* Ground shelf */}
        <rect x="2" y="18" width="90" height="1" fill="var(--border-strong)" />
        <rect x="0" y="18" width="1" height="1" fill="var(--border)" />
        <rect x="93" y="18" width="1" height="1" fill="var(--border)" />

        {/* Book stack */}
        <rect x="5" y="15" width="15" height="3" fill="var(--fg-secondary)" />
        <rect x="6" y="16" width="11" height="1" fill="var(--surface-elevated)" />
        <rect x="18" y="15" width="1" height="3" fill="var(--accent)" />

        <rect x="7" y="12" width="12" height="3" fill="var(--fg-muted)" />
        <rect x="8" y="13" width="9" height="1" fill="var(--surface)" />

        <rect x="6" y="10" width="11" height="2" fill="var(--accent-vivid)" />
        <rect x="14" y="12" width="1" height="2" fill="var(--accent)" />

        {/* Mini desk lamp + warm dark-mode cone */}
        <g class="pixel-lamp-glow">
          <rect x="31" y="9" width="6" height="2" fill="var(--accent-vivid)" />
          <rect x="30" y="11" width="8" height="3" fill="var(--accent-vivid)" />
          <rect x="29" y="14" width="10" height="4" fill="var(--accent-vivid)" />
        </g>
        <rect x="25" y="16" width="8" height="2" fill="var(--fg)" />
        <rect x="27" y="10" width="1" height="6" fill="var(--fg-secondary)" />
        <rect x="28" y="8" width="1" height="2" fill="var(--fg-secondary)" />
        <rect x="29" y="7" width="3" height="1" fill="var(--fg-secondary)" />
        <rect x="31" y="5" width="5" height="1" fill="var(--fg)" />
        <rect x="30" y="6" width="7" height="2" fill="var(--fg)" />
        <rect x="32" y="8" width="3" height="1" fill="var(--accent-vivid)" />

        {/* Coffee mug + rising pixel steam */}
        <rect x="42" y="12" width="7" height="6" fill="var(--fg)" />
        <rect x="43" y="13" width="5" height="4" fill="var(--surface-elevated)" />
        <rect x="43" y="14" width="5" height="1" fill="var(--accent-vivid)" />
        <rect x="49" y="13" width="2" height="1" fill="var(--fg)" />
        <rect x="50" y="14" width="1" height="2" fill="var(--fg)" />
        <rect x="49" y="16" width="2" height="1" fill="var(--fg)" />
        <rect x="44" y="8" width="1" height="2" fill="var(--fg-muted)" class="pixel-steam-1" />
        <rect x="46" y="7" width="1" height="2" fill="var(--fg-muted)" class="pixel-steam-2" />

        {/* Markdown note sheet + blinking cursor */}
        <rect x="56" y="5" width="15" height="13" fill="var(--border-strong)" />
        <rect x="57" y="6" width="13" height="11" fill="var(--surface-elevated)" />
        <rect x="68" y="5" width="3" height="3" fill="var(--bg)" />
        <rect x="68" y="6" width="1" height="2" fill="var(--border-strong)" />
        <rect x="68" y="7" width="2" height="1" fill="var(--border-strong)" />
        <rect x="59" y="8" width="6" height="1" fill="var(--accent-vivid)" />
        <rect x="59" y="10" width="9" height="1" fill="var(--fg-muted)" />
        <rect x="59" y="12" width="8" height="1" fill="var(--fg-muted)" />
        <rect x="59" y="14" width="5" height="1" fill="var(--fg-muted)" />
        <rect x="65" y="14" width="2" height="1" fill="var(--accent-vivid)" class="pixel-cursor-blink" />

        {/* Tiny potted cactus */}
        <rect x="78" y="14" width="6" height="1" fill="var(--accent-vivid)" />
        <rect x="79" y="15" width="4" height="3" fill="var(--accent)" />
        <rect x="80" y="9" width="2" height="5" fill="var(--status-open)" />
        <rect x="78" y="11" width="1" height="2" fill="var(--status-open)" />
        <rect x="79" y="12" width="1" height="1" fill="var(--status-open)" />
        <rect x="83" y="10" width="1" height="2" fill="var(--status-open)" />
        <rect x="82" y="11" width="1" height="1" fill="var(--status-open)" />
      </svg>
    )
  }

  {
    variant === "projects" && (
      <svg
        viewBox="0 0 96 20"
        width="192"
        height="40"
        fill="none"
        shape-rendering="crispEdges"
        class="h-9 w-auto sm:h-10"
      >
        {/* Ground shelf */}
        <rect x="2" y="18" width="90" height="1" fill="var(--border-strong)" />
        <rect x="0" y="18" width="1" height="1" fill="var(--border)" />
        <rect x="93" y="18" width="1" height="1" fill="var(--border)" />

        {/* Mini Terminal Monitor */}
        <rect x="5" y="4" width="19" height="12" fill="var(--fg)" />
        <rect x="6" y="5" width="17" height="10" fill="var(--surface-elevated)" />
        <rect x="6" y="5" width="17" height="2" fill="var(--surface)" />
        <rect x="7" y="5" width="1" height="1" fill="var(--accent-vivid)" />
        <rect x="9" y="5" width="1" height="1" fill="var(--status-open)" />
        <rect x="11" y="5" width="1" height="1" fill="var(--fg-muted)" />
        <rect x="7" y="8" width="6" height="1" fill="var(--accent-vivid)" />
        <rect x="9" y="10" width="10" height="1" fill="var(--status-open)" />
        <rect x="7" y="12" width="8" height="1" fill="var(--fg-muted)" />
        <rect x="16" y="12" width="2" height="1" fill="var(--accent-vivid)" class="pixel-cursor-blink" />
        <rect x="13" y="16" width="3" height="1" fill="var(--fg-muted)" />
        <rect x="11" y="17" width="7" height="1" fill="var(--fg)" />

        {/* Multi-Agent Git Worktree Branches (KD Code) */}
        <rect x="28" y="10" width="2" height="2" fill="var(--fg)" />
        <rect x="30" y="11" width="4" height="1" fill="var(--border-strong)" />

        {/* Top branch (Claude - orange) */}
        <rect x="34" y="7" width="1" height="4" fill="var(--accent-vivid)" />
        <rect x="35" y="7" width="20" height="1" fill="var(--accent-vivid)" />
        <rect x="43" y="6" width="2" height="2" fill="var(--accent-vivid)" />
        <rect x="55" y="7" width="1" height="4" fill="var(--accent-vivid)" />

        {/* Middle branch (Codex - green) */}
        <rect x="34" y="11" width="23" height="1" fill="var(--status-open)" />
        <rect x="46" y="10" width="2" height="2" fill="var(--status-open)" />

        {/* Bottom branch (OpenCode - neutral) */}
        <rect x="34" y="12" width="1" height="3" fill="var(--fg-muted)" />
        <rect x="35" y="14" width="20" height="1" fill="var(--fg-muted)" />
        <rect x="40" y="13" width="2" height="2" fill="var(--fg-muted)" />
        <rect x="55" y="12" width="1" height="3" fill="var(--fg-muted)" />

        {/* Animated signal packet along branches */}
        <rect x="35" y="7" width="2" height="1" fill="var(--surface-elevated)" class="pixel-packet-run" />

        {/* Merge node */}
        <rect x="57" y="10" width="3" height="3" fill="var(--accent-vivid)" />
        <rect x="58" y="11" width="1" height="1" fill="var(--accent-fg)" />

        {/* 2FA Security Padlock (Simple OTP) */}
        <rect x="67" y="6" width="5" height="1" fill="var(--fg-muted)" />
        <rect x="66" y="7" width="1" height="4" fill="var(--fg-muted)" />
        <rect x="72" y="7" width="1" height="4" fill="var(--fg-muted)" />
        <rect x="65" y="11" width="9" height="7" fill="var(--fg)" />
        <rect x="66" y="12" width="7" height="5" fill="var(--surface-elevated)" />
        <rect x="69" y="13" width="1" height="2" fill="var(--status-open)" />
        <rect x="68" y="14" width="3" height="1" fill="var(--status-open)" />

        {/* Shipped Package Crate */}
        <rect x="80" y="10" width="9" height="8" fill="var(--border-strong)" />
        <rect x="81" y="11" width="7" height="6" fill="var(--surface-elevated)" />
        <rect x="84" y="11" width="1" height="6" fill="var(--accent-vivid)" />
        <rect x="81" y="13" width="7" height="1" fill="var(--accent-vivid)" />
        <rect x="87" y="8" width="2" height="2" fill="var(--status-open)" class="pixel-led-pulse" />
      </svg>
    )
  }

  {
    variant === "experience" && (
      <svg
        viewBox="0 0 96 20"
        width="192"
        height="40"
        fill="none"
        shape-rendering="crispEdges"
        class="h-9 w-auto sm:h-10"
      >
        {/* Career horizon ground */}
        <rect x="2" y="18" width="90" height="1" fill="var(--border-strong)" />
        <rect x="0" y="18" width="1" height="1" fill="var(--border)" />
        <rect x="93" y="18" width="1" height="1" fill="var(--border)" />

        {/* Stop 1: Studio (2017) */}
        <rect x="5" y="12" width="9" height="6" fill="var(--border-strong)" />
        <rect x="6" y="13" width="7" height="5" fill="var(--surface)" />
        <rect x="7" y="14" width="2" height="2" fill="var(--fg-muted)" />
        <rect x="10" y="14" width="2" height="2" fill="var(--fg-muted)" />

        {/* Dotted trail */}
        <rect x="16" y="16" width="1" height="1" fill="var(--border-strong)" />
        <rect x="18" y="16" width="1" height="1" fill="var(--border-strong)" />

        {/* Stop 2: Agency / Enterprise */}
        <rect x="21" y="9" width="11" height="9" fill="var(--border-strong)" />
        <rect x="22" y="10" width="9" height="8" fill="var(--surface)" />
        <rect x="24" y="11" width="2" height="2" fill="var(--fg-muted)" />
        <rect x="27" y="11" width="2" height="2" fill="var(--fg-muted)" />
        <rect x="24" y="14" width="2" height="2" fill="var(--fg-muted)" />
        <rect x="27" y="14" width="2" height="2" fill="var(--fg-muted)" />

        {/* Dotted trail */}
        <rect x="34" y="16" width="1" height="1" fill="var(--border-strong)" />
        <rect x="36" y="16" width="1" height="1" fill="var(--border-strong)" />

        {/* Stop 3: High-scale Product Tower (30M+ / 2M+) */}
        <rect x="45" y="3" width="1" height="3" fill="var(--fg-muted)" />
        <rect x="39" y="6" width="13" height="12" fill="var(--fg-muted)" />
        <rect x="40" y="7" width="11" height="11" fill="var(--surface-elevated)" />
        <rect x="42" y="8" width="2" height="2" fill="var(--fg-muted)" />
        <rect x="45" y="8" width="2" height="2" fill="var(--accent-vivid)" />
        <rect x="48" y="8" width="2" height="2" fill="var(--fg-muted)" />
        <rect x="42" y="11" width="2" height="2" fill="var(--fg-muted)" />
        <rect x="45" y="11" width="2" height="2" fill="var(--fg-muted)" />
        <rect x="48" y="11" width="2" height="2" fill="var(--fg-muted)" />
        <rect x="44" y="15" width="3" height="3" fill="var(--border-strong)" />

        {/* Dotted trail */}
        <rect x="54" y="16" width="1" height="1" fill="var(--border-strong)" />
        <rect x="56" y="16" width="1" height="1" fill="var(--border-strong)" />

        {/* Stop 4: Front-End Lead */}
        <rect x="59" y="8" width="11" height="10" fill="var(--fg-muted)" />
        <rect x="60" y="9" width="9" height="9" fill="var(--surface-elevated)" />
        <rect x="61" y="10" width="7" height="1" fill="var(--fg-muted)" />
        <rect x="61" y="12" width="7" height="1" fill="var(--fg-muted)" />
        <rect x="61" y="14" width="4" height="1" fill="var(--accent)" />

        {/* Active trail to current milestone */}
        <rect x="72" y="16" width="1" height="1" fill="var(--accent-vivid)" />
        <rect x="74" y="16" width="1" height="1" fill="var(--accent-vivid)" />
        <rect x="76" y="16" width="1" height="1" fill="var(--accent-vivid)" />

        {/* Stop 5: Current Flag Checkpoint (KD Labs) */}
        <rect x="79" y="16" width="8" height="2" fill="var(--fg)" />
        <rect x="81" y="5" width="1" height="11" fill="var(--fg)" />
        <g class="pixel-flag-wave">
          <rect x="82" y="5" width="7" height="4" fill="var(--accent-vivid)" />
          <rect x="89" y="6" width="2" height="3" fill="var(--accent)" />
          <rect x="84" y="6" width="2" height="1" fill="var(--accent-fg)" />
        </g>
        <rect x="84" y="14" width="2" height="2" fill="var(--status-open)" class="pixel-led-pulse" />
      </svg>
    )
  }

  {
    variant === "footer" && (
      <svg
        viewBox="0 0 96 20"
        width="192"
        height="40"
        fill="none"
        shape-rendering="crispEdges"
        class="h-9 w-auto sm:h-10"
      >
        {/* Ground shelf */}
        <rect x="2" y="18" width="90" height="1" fill="var(--border-strong)" />
        <rect x="0" y="18" width="1" height="1" fill="var(--border)" />
        <rect x="93" y="18" width="1" height="1" fill="var(--border)" />

        {/* Pixel Mailbox on Post */}
        <rect x="12" y="17" width="6" height="1" fill="var(--fg-muted)" />
        <rect x="14" y="12" width="2" height="5" fill="var(--fg-muted)" />
        <rect x="7" y="6" width="13" height="1" fill="var(--fg)" />
        <rect x="6" y="7" width="15" height="5" fill="var(--fg)" />
        <rect x="7" y="7" width="10" height="4" fill="var(--surface-elevated)" />
        <rect x="18" y="7" width="2" height="4" fill="var(--surface)" />
        {/* Tiny envelope peeking out */}
        <rect x="20" y="8" width="3" height="2" fill="var(--surface-elevated)" />
        <rect x="21" y="8" width="1" height="1" fill="var(--accent-vivid)" />
        {/* Status LED on mailbox */}
        <rect x="8" y="9" width="2" height="1" fill="var(--status-open)" class="pixel-led-pulse" />
        {/* Raised orange mailbox flag */}
        <g class="pixel-flag-wave">
          <rect x="11" y="3" width="1" height="6" fill="var(--accent-vivid)" />
          <rect x="12" y="3" width="4" height="2" fill="var(--accent-vivid)" />
          <rect x="15" y="4" width="1" height="1" fill="var(--accent)" />
        </g>
        {/* Tiny coastal grass tuft */}
        <rect x="8" y="17" width="1" height="1" fill="var(--status-open)" />
        <rect x="9" y="16" width="1" height="2" fill="var(--status-open)" />
        <rect x="10" y="17" width="1" height="1" fill="var(--status-open)" />

        {/* Sealed Pixel Postcard / Envelope */}
        <rect x="29" y="9" width="13" height="9" fill="var(--border-strong)" />
        <rect x="30" y="10" width="11" height="7" fill="var(--surface-elevated)" />
        <rect x="30" y="10" width="1" height="1" fill="var(--fg-muted)" />
        <rect x="31" y="11" width="1" height="1" fill="var(--fg-muted)" />
        <rect x="32" y="12" width="1" height="1" fill="var(--fg-muted)" />
        <rect x="33" y="13" width="1" height="1" fill="var(--fg-muted)" />
        <rect x="34" y="14" width="3" height="1" fill="var(--accent-vivid)" />
        <rect x="37" y="13" width="1" height="1" fill="var(--fg-muted)" />
        <rect x="38" y="12" width="1" height="1" fill="var(--fg-muted)" />
        <rect x="39" y="11" width="1" height="1" fill="var(--fg-muted)" />
        <rect x="40" y="10" width="1" height="1" fill="var(--fg-muted)" />

        {/* Dotted Flight Trail */}
        <rect x="46" y="15" width="1" height="1" fill="var(--border-strong)" />
        <rect x="48" y="14" width="1" height="1" fill="var(--border-strong)" />
        <rect x="50" y="13" width="1" height="1" fill="var(--border-strong)" />
        <rect x="52" y="12" width="1" height="1" fill="var(--fg-muted)" />
        <rect x="54" y="10" width="1" height="1" fill="var(--fg-muted)" />
        <rect x="56" y="9" width="1" height="1" fill="var(--accent)" />

        {/* Paper Plane */}
        <g class="pixel-plane-glide">
          <rect x="66" y="4" width="4" height="1" fill="var(--fg)" />
          <rect x="63" y="5" width="6" height="1" fill="var(--fg)" />
          <rect x="65" y="5" width="3" height="1" fill="var(--surface-elevated)" />
          <rect x="60" y="6" width="8" height="1" fill="var(--fg)" />
          <rect x="62" y="6" width="5" height="1" fill="var(--surface-elevated)" />
          <rect x="59" y="7" width="8" height="1" fill="var(--fg)" />
          <rect x="61" y="7" width="4" height="1" fill="var(--accent-vivid)" />
          <rect x="62" y="8" width="4" height="1" fill="var(--fg)" />
          <rect x="63" y="8" width="2" height="1" fill="var(--accent)" />
          <rect x="63" y="9" width="2" height="1" fill="var(--fg)" />
          <rect x="64" y="10" width="1" height="1" fill="var(--fg-muted)" />
        </g>

        {/* Coastal Pixel Seagulls */}
        <g class="pixel-gull-1">
          <rect x="76" y="5" width="2" height="1" fill="var(--fg-secondary)" />
          <rect x="78" y="4" width="2" height="1" fill="var(--fg-secondary)" />
          <rect x="80" y="5" width="1" height="1" fill="var(--fg)" />
          <rect x="81" y="4" width="2" height="1" fill="var(--fg-secondary)" />
          <rect x="83" y="5" width="2" height="1" fill="var(--fg-secondary)" />
        </g>
        <g class="pixel-gull-2">
          <rect x="84" y="11" width="1" height="1" fill="var(--fg-muted)" />
          <rect x="85" y="10" width="2" height="1" fill="var(--fg-muted)" />
          <rect x="87" y="11" width="1" height="1" fill="var(--fg-secondary)" />
          <rect x="88" y="10" width="2" height="1" fill="var(--fg-muted)" />
          <rect x="90" y="11" width="1" height="1" fill="var(--fg-muted)" />
        </g>

        {/* Soft Pixel Cloud Puff */}
        <rect x="75" y="13" width="4" height="1" fill="var(--surface-elevated)" />
        <rect x="73" y="14" width="8" height="1" fill="var(--surface-elevated)" />
        <rect x="74" y="15" width="6" height="1" fill="var(--border-strong)" />
      </svg>
    )
  }
</div>
