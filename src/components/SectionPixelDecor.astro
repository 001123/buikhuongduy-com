          <rect x="75" y="3" width="4" height="2" fill="var(--accent-vivid)" />
          <rect x="74" y="5" width="6" height="7" fill="var(--fg)" />
          <rect x="75" y="5" width="4" height="6" fill="var(--surface-elevated)" />
          <rect x="76" y="6" width="2" height="2" fill="var(--status-open)" />
