        <rect x="78" y="14" width="6" height="1" fill="var(--accent-vivid)" />
        <rect x="79" y="15" width="4" height="3" fill="var(--accent)" />
        <rect x="80" y="9" width="2" height="5" fill="var(--status-open)" />
        <rect x="78" y="11" width="1" height="2" fill="var(--status-open)" />
        <rect x="79" y="12" width="1" height="1" fill="var(--status-open)" />
        <rect x="83" y="10" width="1" height="2" fill="var(--status-open)" />
        <rect x="82" y="11" width="1" height="1" fill="var(--status-open)" />
      </svg>
