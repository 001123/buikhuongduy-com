        <rect x="59" y="10" width="9" height="1" fill="var(--fg-muted)" />
        <rect x="59" y="12" width="8" height="1" fill="var(--fg-muted)" />
        <rect x="59" y="14" width="5" height="1" fill="var(--fg-muted)" />
