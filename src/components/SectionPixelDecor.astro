        <rect x="33" y="8" width="2" height="1" fill="var(--accent-vivid)" />
        <rect x="36" y="8" width="7" height="1" fill="var(--fg-secondary)" />
        <rect x="34" y="10" width="9" height="1" fill="var(--status-open)" />
