---
import type { Project } from "../data/projects";
import { useTranslations, type Lang } from "../i18n/ui";

interface Props {
  projects: Project[];
  lang: Lang;
}

const { projects, lang } = Astro.props;
const t = useTranslations(lang);
const prodCount = projects.filter((p) => p.category === "production").length;
const ossCount = projects.filter((p) => p.category === "open-source").length;

const filters = [
  { id: "all", label: t("projects.filterAll"), count: projects.length, dot: null },
  { id: "production", label: t("projects.filterProduction"), count: prodCount, dot: "bg-status-open" },
  { id: "open-source", label: t("projects.filterOpenSource"), count: ossCount, dot: "bg-accent-vivid" },
] as const;
---

<div
  role="group"
  aria-label={t("projects.title")}
  data-project-filters
  class="inline-flex flex-wrap items-center gap-1 rounded-full border border-border bg-bg/90 p-1 shadow-2xs dark:bg-surface-elevated"
>
  {
    filters.map((f, idx) => (
      <button
        type="button"
        data-project-filter={f.id}
        aria-pressed={idx === 0 ? "true" : "false"}
        class="group inline-flex items-center gap-1.5 rounded-full px-3 py-1.5 text-xs font-medium text-fg-secondary transition-all duration-150 hover:bg-surface hover:text-fg aria-pressed:bg-fg aria-pressed:text-bg aria-pressed:shadow-xs aria-pressed:hover:bg-fg aria-pressed:hover:text-bg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      >
        {f.dot && (
          <span
            aria-hidden="true"
            class:list={["size-1.5 shrink-0 rounded-full", f.dot]}
          />
        )}
        <span>{f.label}</span>
        <span class="rounded-full bg-surface px-1.5 py-0.5 font-mono text-[0.6875rem] leading-none tabular-nums text-fg-muted transition-colors group-aria-pressed:bg-bg/20 group-aria-pressed:text-bg">
          {f.count}
        </span>
      </button>
    ))
  }
</div>

<script>
  function initProjectFilters() {
    document.querySelectorAll<HTMLElement>("[data-projects-scope]").forEach((scope) => {
      if (scope.dataset.filterBound) return;
      scope.dataset.filterBound = "1";
      const buttons = scope.querySelectorAll<HTMLButtonElement>("[data-project-filter]");
      const groups = scope.querySelectorAll<HTMLElement>("[data-project-group]");
      const cards = scope.querySelectorAll<HTMLElement>("[data-project-category]");

      buttons.forEach((btn) => {
        btn.addEventListener("click", () => {
          const target = btn.dataset.projectFilter ?? "all";
          buttons.forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
          groups.forEach((group) => {
            const match = target === "all" || group.dataset.projectGroup === target;
            group.classList.toggle("hidden", !match);
          });
          cards.forEach((card) => {
            const match = target === "all" || card.dataset.projectCategory === target;
            card.classList.toggle("hidden", !match);
            if (match && card.dataset.reveal === "pending") {
              card.dataset.reveal = "visible";
            }
          });
        });
      });
    });
  }

  initProjectFilters();
  document.addEventListener("astro:page-load", initProjectFilters);
</script>
