---
import { Picture } from "astro:assets";
import bgHome from "../assets/bg-home.webp";

interface Props {
  /** Darker overlay for content pages so text stays readable. */
  dim?: boolean;
}

const { dim = false } = Astro.props;

/**
 * 24px-wide blurred preview of bg-home.webp, inlined so the first paint already shows the scene
 * instead of a flat colour (big Speed Index win). Regenerate if the image changes:
 * sharp("src/assets/bg-home.webp").resize(24).webp({ quality: 40 }).toBuffer() → base64.
 */
const placeholder =
  "data:image/webp;base64,UklGRqgAAABXRUJQVlA4IJwAAACQBQCdASoYABIAPu1sq1EppaOiqAqpMB2JZACdG1/tv8Ax73Bex/CZyzb9eS0rVQRUGXrFAAD+z+upRi3hOJtVGCBI4H9mh9HICE+41IBiNImXdWefz17r+RauDsDgOxcFyxGLd5ZyqJyUJCEzcYJROkFyW2GSKFE43N7RxtFxaBFQ//WAAyaBtcbEbwkXZ901o91mc56q1GjDAAA=";
---

<div class="fixed inset-0 -z-20 overflow-hidden bg-[#87694a]" transition:name="home-bg" transition:animate="none">
  <div
    aria-hidden="true"
    class="absolute inset-0 scale-110 bg-cover bg-[55%_center] blur-xl"
    style={`background-image: url(${placeholder})`}
  ></div>
  <Picture
    src={bgHome}
    alt=""
    formats={["avif", "webp"]}
    fallbackFormat="webp"
    widths={[640, 960, 1280, bgHome.width]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    pictureAttributes={{ class: "relative block h-full w-full" }}
    class="h-full w-full object-cover object-[55%_center]"
  />
</div>
<div
  aria-hidden="true"
  transition:name="home-overlay"
  class:list={[
    "fixed inset-0 -z-10",
    dim ? "bg-ink/75" : "bg-linear-to-b from-ink/60 via-ink/10 via-45% to-transparent",
  ]}
></div>
