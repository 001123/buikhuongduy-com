---
// Lời kết cuối trang: cảm ơn + về trang chủ / lên đầu trang.
// Chỉ hiện khi trang dài hơn màn hình (người đọc thực sự đã cuộn tới cuối).
import { getLang, homePath, useTranslations } from "../i18n/ui";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const pill =
  "group inline-flex items-center gap-1.5 rounded-full border border-paper/20 bg-ink/40 px-3.5 py-1.5 text-sm text-paper/60 backdrop-blur-md glow-hover hover:border-rice/60 hover:text-rice focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rice";
const icon = "size-4 transition-transform duration-300";
---

<footer data-scroll-top hidden class="flex flex-col items-center gap-4 pt-10 text-center sm:pt-12">
  <span aria-hidden="true" class="h-px w-24 bg-linear-to-r from-transparent via-rice/60 to-transparent"></span>
  <div class="space-y-1">
    <p class="font-serif text-lg text-paper/80 italic">{t("end.thanks")}</p>
    <p class="text-sm text-paper/50">{t("end.prompt")}</p>
  </div>
  <div class="flex flex-wrap justify-center gap-3">
    <a href={homePath[lang]} class={pill}>
      <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={`${icon} group-hover:-translate-x-0.5`}>
        <path d="M15 18l-6-6 6-6"></path>
      </svg>
      {t("nav.home")}
    </a>
    <button type="button" class={pill}>
      <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={`${icon} group-hover:-translate-y-0.5`}>
        <path d="M18 15l-6-6-6 6"></path>
      </svg>
      {t("scroll.top")}
    </button>
  </div>
</footer>

<style>
  [data-scroll-top]:not([hidden]) {
    animation: var(--animate-fade-up);
  }
</style>

<script>
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  let frame = 0;

  function update() {
    frame = 0;
    const el = document.querySelector<HTMLElement>("[data-scroll-top]");
    if (!el) return;
    // Trừ chiều cao của chính khối này để tránh bật/tắt qua lại ở ngưỡng.
    const ownHeight = el.hidden ? 0 : el.offsetHeight;
    const scrollable = document.documentElement.scrollHeight - ownHeight > window.innerHeight + 1;
    if (el.hidden === scrollable) el.hidden = !scrollable;
  }

  function schedule() {
    if (!frame) frame = requestAnimationFrame(update);
  }

  window.addEventListener("resize", schedule, { passive: true });
  new ResizeObserver(schedule).observe(document.body);
  document.addEventListener("astro:page-load", schedule);

  document.addEventListener("click", (e) => {
    if (!(e.target instanceof Element) || !e.target.closest("[data-scroll-top] button")) return;
    window.scrollTo({ top: 0, behavior: reduceMotion.matches ? "auto" : "smooth" });
  });
</script>
