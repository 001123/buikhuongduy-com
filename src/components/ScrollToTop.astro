---
// End-of-page outro: thank-you + go back (home as fallback) / back to top.
// Shown only when the page is taller than the viewport (the reader actually scrolled to the end).
import { getLang, homePath, useTranslations } from "../i18n/ui";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
// Each action is a full-width button on its own row.
const button =
  "flex w-full cursor-pointer items-center justify-center gap-2 rounded-full border border-paper/15 px-5 py-2.5 text-sm text-paper/80 glow-hover hover:border-rice/60 hover:text-rice focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rice";
// Lucide-style stroke icons (24x24 viewBox).
const icons = {
  back: ["M19 12H5", "M12 19l-7-7 7-7"],
  top: ["M12 19V5", "M5 12l7-7 7 7"],
};
const svg = {
  "aria-hidden": "true",
  viewBox: "0 0 24 24",
  fill: "none",
  stroke: "currentColor",
  "stroke-width": "2",
  "stroke-linecap": "round",
  "stroke-linejoin": "round",
  class: "size-4 shrink-0",
} as const;
---

<footer data-scroll-top hidden class="mx-auto mt-10 flex w-fit max-w-full flex-col items-center gap-4 rounded-2xl border border-paper/10 bg-ink px-6 pt-0 pb-6 text-center shadow-lg shadow-black/30 sm:mt-12 sm:px-10">
  <span aria-hidden="true" class="h-px w-24 bg-linear-to-r from-transparent via-rice/60 to-transparent"></span>
  <p class="font-serif text-lg text-paper/80">{t("end.thanks")}</p>
  <div class="flex w-full flex-col gap-3">
    <a href={homePath[lang]} data-back class={button}>
      <svg {...svg}>{icons.back.map((d) => <path d={d} />)}</svg>
      <span class="inline-block first-letter:uppercase">{t("end.back")}</span>
    </a>
    <button type="button" data-top class={button}>
      <svg {...svg}>{icons.top.map((d) => <path d={d} />)}</svg>
      <span class="inline-block first-letter:uppercase">{t("end.top")}</span>
    </button>
  </div>
</footer>

<style>
  [data-scroll-top]:not([hidden]) {
    animation: var(--animate-fade-up);
  }
</style>

<script>
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  let frame = 0;

  function update() {
    frame = 0;
    const el = document.querySelector<HTMLElement>("[data-scroll-top]");
    if (!el) return;
    // Subtract this block's own height to avoid toggling back and forth at the threshold.
    const ownHeight = el.hidden ? 0 : el.offsetHeight;
    const scrollable = document.documentElement.scrollHeight - ownHeight > window.innerHeight + 1;
    if (el.hidden === scrollable) el.hidden = !scrollable;
  }

  function schedule() {
    if (!frame) frame = requestAnimationFrame(update);
  }

  window.addEventListener("resize", schedule, { passive: true });
  new ResizeObserver(schedule).observe(document.body);
  document.addEventListener("astro:page-load", schedule);

  // True when the previous history entry is a page on this site (full load or client-side navigation).
  function hasInternalHistory() {
    if (history.state?.index > 0) return true;
    try {
      return !!document.referrer && new URL(document.referrer).origin === location.origin;
    } catch {
      return false;
    }
  }

  document.addEventListener("click", (e) => {
    if (!(e.target instanceof Element)) return;
    if (e.target.closest("[data-scroll-top] [data-back]")) {
      if (e instanceof MouseEvent && (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0)) return;
      if (!hasInternalHistory()) return; // Fall back to the link's home href.
      e.preventDefault();
      history.back();
      return;
    }
    if (!e.target.closest("[data-scroll-top] [data-top]")) return;
    window.scrollTo({ top: 0, behavior: reduceMotion.matches ? "auto" : "smooth" });
  });
</script>
