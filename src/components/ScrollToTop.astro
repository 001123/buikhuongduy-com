---
// Nút lên đầu trang: chỉ xuất hiện khi trang dài (≥ 2 màn hình) và người dùng đã cuộn xuống.
// Vòng viền mảnh thể hiện tiến độ cuộn.
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<button
  type="button"
  id="scroll-to-top"
  aria-label={label}
  title={label}
  tabindex="-1"
  class="scroll-top group fixed right-4 bottom-4 z-50 grid size-11 place-items-center rounded-full bg-ink/50 text-paper/80 shadow-lg shadow-ink/40 backdrop-blur-md glow-hover hover:text-rice focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rice sm:right-6 sm:bottom-6"
>
  <svg aria-hidden="true" viewBox="0 0 44 44" class="absolute inset-0 size-full -rotate-90">
    <circle cx="22" cy="22" r="21" fill="none" stroke="currentColor" stroke-opacity="0.2" stroke-width="1" />
    <circle
      class="scroll-top-progress"
      cx="22"
      cy="22"
      r="21"
      fill="none"
      stroke="var(--color-rice)"
      stroke-width="1.5"
      stroke-linecap="round"
      pathLength="1"
      stroke-dasharray="1"
      stroke-dashoffset="1"></circle>
  </svg>
  <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4 transition-transform duration-300 group-hover:-translate-y-0.5">
    <path d="M18 15l-6-6-6 6"></path>
  </svg>
</button>

<style>
  .scroll-top {
    opacity: 0;
    visibility: hidden;
    translate: 0 0.75rem;
    transition:
      opacity 0.4s cubic-bezier(0.22, 1, 0.36, 1),
      translate 0.4s cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0s linear 0.4s,
      color 250ms,
      box-shadow 250ms;
  }

  .scroll-top[data-visible] {
    opacity: 1;
    visibility: visible;
    translate: 0 0;
    transition-delay: 0s;
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-top,
    .scroll-top[data-visible] {
      translate: none;
    }
  }
</style>

<script>
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  let frame = 0;

  function update() {
    frame = 0;
    const btn = document.getElementById("scroll-to-top");
    if (!btn) return;

    const viewport = window.innerHeight;
    const scrollable = document.documentElement.scrollHeight - viewport;
    // Trang ngắn hơn ~2 màn hình thì không cần nút.
    const isLong = scrollable > viewport;
    const visible = isLong && window.scrollY > viewport * 0.75;

    btn.toggleAttribute("data-visible", visible);
    btn.tabIndex = visible ? 0 : -1;

    const progress = scrollable > 0 ? Math.min(window.scrollY / scrollable, 1) : 0;
    btn.querySelector<SVGCircleElement>(".scroll-top-progress")?.setAttribute("stroke-dashoffset", String(1 - progress));
  }

  function schedule() {
    if (!frame) frame = requestAnimationFrame(update);
  }

  window.addEventListener("scroll", schedule, { passive: true });
  window.addEventListener("resize", schedule, { passive: true });
  new ResizeObserver(schedule).observe(document.documentElement);

  document.addEventListener("click", (e) => {
    if (!(e.target instanceof Element) || !e.target.closest("#scroll-to-top")) return;
    window.scrollTo({ top: 0, behavior: reduceMotion.matches ? "auto" : "smooth" });
  });

  document.addEventListener("astro:page-load", schedule);
</script>
