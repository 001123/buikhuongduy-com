---
import type { Project } from "../data/projects";
import { useTranslations, type Lang } from "../i18n/ui";

interface Props {
  project: Project;
  lang: Lang;
  class?: string;
  reveal?: boolean;
}

const { project, lang, class: className = "", reveal = false } = Astro.props;
const t = useTranslations(lang);
const isProduction = project.category === "production";
const categoryLabel = isProduction ? t("projects.badgeProduction") : t("projects.badgeOpenSource");
const Tag = project.href ? "a" : "article";
const linkProps = project.href ? { href: project.href, target: "_blank", rel: "noopener" } : {};
---

<Tag
  {...linkProps}
  data-project-card
  data-project-category={project.category}
  data-reveal={reveal ? "pending" : undefined}
  class:list={[
    "spotlight-card flex flex-col rounded-2xl p-6",
    project.href &&
      "group focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent",
    className,
  ]}
>
  <div class="flex flex-wrap items-center justify-between gap-x-3 gap-y-2">
    <div class="flex min-w-0 items-center gap-2.5">
      <span
        class:list={[
          "inline-flex shrink-0 items-center gap-1.5 rounded-full border px-2.5 py-1 text-xs font-medium leading-none",
          isProduction
            ? "border-border-strong/80 bg-surface text-fg-secondary dark:bg-surface/80"
            : "border-accent/20 bg-accent-soft text-accent",
        ]}
      >
        <span
          aria-hidden="true"
          class:list={[
            "size-1.5 shrink-0 rounded-full",
            isProduction ? "bg-status-open" : "bg-accent-vivid",
          ]}
        />
        <span>{categoryLabel}</span>
      </span>
      <span class="truncate text-xs text-fg-muted">{project.org}</span>
    </div>

    {project.href ? (
      <span
        aria-hidden="true"
        class="shrink-0 font-mono text-xs text-fg-muted transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-accent"
      >
        {project.linkLabel ?? "↗"}
      </span>
    ) : project.links && project.links.length > 0 ? (
      <div class="flex shrink-0 flex-wrap items-center gap-x-2.5 gap-y-1">
        {project.links.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-0.5 font-mono text-xs text-fg-muted transition-colors hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
          >
            <span>{link.label}</span>
            <span aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    ) : (
      <span class="shrink-0 font-mono text-[0.6875rem] text-fg-muted tabular-nums">{project.period}</span>
    )}
  </div>

  <div class="mt-3 flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
    <h4
      class:list={[
        "text-lg font-semibold tracking-[-0.02em] text-fg",
        project.href && "transition-colors group-hover:text-accent",
      ]}
    >
      {project.name}
    </h4>
    {project.impact && (
      <span class="font-mono text-[0.6875rem] font-medium text-accent">{project.impact}</span>
    )}
  </div>

  <p class="mt-1 font-mono text-[0.6875rem] text-fg-muted tabular-nums">
    {project.role ? `${project.role} · ${project.period}` : project.period}
  </p>

  <p class="mt-2.5 text-sm leading-relaxed text-fg-secondary">{project.summary}</p>

  <div class="mt-auto flex flex-wrap gap-1.5 pt-4">
    {project.tags.map((tag) => (
      <span class="rounded-md border border-border bg-surface px-2 py-0.5 font-mono text-[0.6875rem] text-fg-muted">
        {tag}
      </span>
    ))}
  </div>
</Tag>
