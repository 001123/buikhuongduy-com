---
import SectionPage from "../../layouts/SectionPage.astro";
import ExperienceTimeline from "../../components/ExperienceTimeline.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import ProjectFilter from "../../components/ProjectFilter.astro";
import { getLang, sectionPaths, useTranslations } from "../../i18n/ui";
import mascot from "../../assets/mascot-pixel.gif";
import { awards, certifications, education, experiences } from "../../data/experience";
import { cvPdfPath, cvUrl, socials } from "../../data/profile";
import { projects } from "../../data/projects";
import { gitDates } from "../../lib/git-dates";

const dates = gitDates([
  "src/components/sections/About.astro",
  "src/data/profile.ts",
  "src/data/projects.ts",
  "src/data/experience.ts",
]);

const linkedinUrl = socials.find((s) => s.icon === "linkedin")!.href;
const kdLabsName = "KD Labs";
const kdLabsUrl = "https://kd.io.vn";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

const skillGroups = {
  vi: [
    { group: "Frontend", items: "JavaScript / TypeScript, React / Next.js, Micro-frontends, Vue / Nuxt, CSS, SCSS, Tailwind, UI/UX" },
    { group: "Backend & Data", items: "Node.js, Bun, GraphQL, REST APIs, SQL, NoSQL" },
    { group: "Infra & DevOps", items: "Docker, Kubernetes, Terraform, CI/CD, AWS, GCP, Cloudflare" },
    { group: "AI & Testing", items: "AI Agents, Skills, MCP, Vitest, Playwright, agent-browser, Webpack, Vite" },
  ],
  en: [
    { group: "Frontend", items: "JavaScript / TypeScript, React / Next.js, Micro-frontends, Vue / Nuxt, CSS, SCSS, Tailwind, UI/UX" },
    { group: "Backend & Data", items: "Node.js, Bun, GraphQL, REST APIs, SQL, NoSQL" },
    { group: "Infra & DevOps", items: "Docker, Kubernetes, Terraform, CI/CD, AWS, GCP, Cloudflare" },
    { group: "AI & Testing", items: "AI Agents, Skills, MCP, Vitest, Playwright, agent-browser, Webpack, Vite" },
  ],
}[lang];

const content = {
  vi: {
    avatarAlt: "Mascot pixel của Bùi Khương Duy",
    intro: [
      "Xin chào, mình là Duy (Timi), Lead/Senior Frontend Engineer kiêm Full-Stack Developer theo hướng AI-native với hơn 9 năm kinh nghiệm xây dựng trọn vẹn sản phẩm web và mobile lưu lượng lớn. Thế mạnh của mình là frontend với React, Next.js, Vue và TypeScript, cùng kinh nghiệm thực tế ở backend và hạ tầng: dịch vụ Node.js, GraphQL và REST API, SQL/NoSQL, AWS và Cloudflare với Terraform, Docker, Kubernetes và CI/CD.",
      "Mình từng dẫn dắt đội 10 lập trình viên, thiết kế nền tảng multi-tenant phục vụ hàng triệu lượt truy cập mỗi tháng, và làm sản phẩm từ nền tảng bảo hiểm hơn 2 triệu khách hàng đến các trang sức khoẻ hơn 30 triệu lượt xem mỗi tháng. Mình đưa AI vào cả sản phẩm lẫn cách đội làm việc, từ backend Node.js cho AI Content Engine dùng LLM đến quy trình Claude Code cho cả team.",
      "Hiện mình điều hành KD Labs, nơi phát triển các công cụ mã nguồn mở cho lập trình viên như KD Code, một extension VS Code điều phối nhiều coding agent cùng lúc.",
      "Suốt chặng đường đó, trải qua nhiều dự án, nhiều đội nhóm và cả những lúc vấp ngã, mình vẫn luôn cố gắng học hỏi và tối ưu từng ngày. Mình biết ơn tất cả những người đã giúp đỡ, đồng hành và chỉ dạy, cùng những bài học từ cuộc sống đã giúp mình trưởng thành như hôm nay.",
    ],
    languages: "Tiếng Việt (bản ngữ) · Tiếng Anh (giao tiếp công việc)",
  },
  en: {
    avatarAlt: "Pixel mascot of Bui Khuong Duy",
    intro: [
      "Hi, I'm Duy (Timi), an AI-native Lead/Senior Frontend Engineer and Full-Stack Developer with 9+ years of experience building high-traffic web and mobile products end to end. My core strength is the frontend with React, Next.js, Vue and TypeScript, backed by hands-on work in backend and infrastructure: Node.js services, GraphQL and REST APIs, SQL/NoSQL, and AWS and Cloudflare with Terraform, Docker, Kubernetes and CI/CD.",
      "I've led a team of 10 developers, architected multi-tenant platforms serving millions of monthly visits, and shipped products ranging from a 2M+ customer insurance platform to healthcare sites with 30M+ monthly views. I build AI into both products and the way teams work, from the Node.js backend of an LLM-powered content engine to Claude Code workflows across the team.",
      "I also run KD Labs, where I build open-source developer tools like KD Code, a VS Code extension that orchestrates multiple coding agents.",
      "Over these 9+ years, through many projects, teams and a few stumbles along the way, I keep learning and improving every day. I'm grateful to everyone who has helped, guided and worked alongside me, and to the life lessons that shaped who I am today.",
    ],
    languages: "Vietnamese (native) · English (working proficiency)",
  },
}[lang];

const experienceList = experiences[lang];
const projectList = projects[lang];
const certList = certifications[lang];
const awardList = awards[lang];
const edu = education[lang];
---

<SectionPage section="about" title={t("about.title")} lead={t("about.lead")} dates={dates}>
  <div class="flow-root text-base leading-7 text-pretty [&>p]:leading-7 [&>p:first-of-type]:mt-0">
    <div class="not-prose mb-6 flex justify-center sm:float-left sm:mt-1 sm:mr-7 sm:mb-4">
      <a
        href={linkedinUrl}
        target="_blank"
        rel="noopener"
        aria-label={`${content.avatarAlt} (LinkedIn)`}
        class="block rounded-xl transition-transform duration-200 hover:-translate-y-1 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
      >
        <img
          src={mascot.src}
          alt={content.avatarAlt}
          width={144}
          height={144}
          loading="eager"
          decoding="async"
          class="size-32 object-contain sm:size-36"
        />
      </a>
    </div>
    {
      content.intro.map((p, i) =>
        i === content.intro.length - 1 ? (
          <p>
            {p} {t("about.blog")}{" "}
            <a href={sectionPaths.blog[lang]}>{t("about.blogLink")}</a>.
          </p>
        ) : p.includes(kdLabsName) ? (
          <p>
            {p.split(kdLabsName).map((part, j) =>
              j === 0 ? (
                part
              ) : (
                <Fragment>
                  <a href={kdLabsUrl} target="_blank" rel="noopener">
                    {kdLabsName}
                  </a>
                  {part}
                </Fragment>
              ),
            )}
          </p>
        ) : (
          <p>{p}</p>
        ),
      )
    }
  </div>

  <h2 id="experience">{t("about.experience")}</h2>
  <ExperienceTimeline items={experienceList} lang={lang} variant="timeline" showAvailability={true} />

  <div data-projects-scope class="mt-12">
    <div class="not-prose mb-5 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <h2 id="projects" class="text-2xl font-semibold tracking-[-0.025em] text-fg">{t("projects.title")}</h2>
      <ProjectFilter projects={projectList} lang={lang} />
    </div>
    <div class="not-prose grid gap-4 sm:grid-cols-2">
      {projectList.map((p) => <ProjectCard project={p} lang={lang} />)}
    </div>
  </div>

  <h2>{t("projects.skills")}</h2>
  <dl class="not-prose divide-y divide-border border-y border-border">
    {
      skillGroups.map((s) => (
        <div class="grid gap-1 py-3.5 sm:grid-cols-[10.5rem_1fr] sm:gap-x-6">
          <dt class="font-mono text-xs font-medium text-fg-muted sm:pt-0.5">{s.group}</dt>
          <dd class="text-sm leading-relaxed text-fg-secondary">{s.items}</dd>
        </div>
      ))
    }
  </dl>

  <div class="not-prose mt-10 grid gap-6 sm:grid-cols-2">
    <section aria-labelledby="about-certs" class="spotlight-card rounded-2xl p-5">
      <h2 id="about-certs" class="font-mono text-xs font-semibold uppercase tracking-[0.08em] text-fg-muted">
        {t("about.certifications")}
      </h2>
      <ul class="mt-3 divide-y divide-border">
        {
          certList.map((cert) => (
            <li class="py-3 first:pt-0 last:pb-0">
              <a
                href={cert.href}
                target="_blank"
                rel="noopener"
                class="group flex items-baseline justify-between gap-2 text-sm font-medium text-fg transition-colors hover:text-accent"
              >
                <span>{cert.title}</span>
                <span aria-hidden="true" class="font-mono text-xs text-fg-muted group-hover:text-accent">↗</span>
              </a>
              <p class="mt-0.5 font-mono text-[0.6875rem] text-fg-muted">{cert.issuer}</p>
            </li>
          ))
        }
      </ul>
      <div class="mt-4 border-t border-border pt-3.5">
        <h3 class="font-mono text-[0.6875rem] font-semibold uppercase tracking-[0.08em] text-fg-muted">
          {t("about.education")}
        </h3>
        <p class="mt-1.5 text-sm font-medium text-fg">{edu.school}</p>
        <p class="text-xs text-fg-secondary">
          {edu.program} · <span class="font-mono text-fg-muted">{edu.period}</span>
        </p>
      </div>
    </section>

    <section aria-labelledby="about-awards" class="spotlight-card rounded-2xl p-5">
      <h2 id="about-awards" class="font-mono text-xs font-semibold uppercase tracking-[0.08em] text-fg-muted">
        {t("about.awards")}
      </h2>
      <ul class="mt-3 divide-y divide-border">
        {
          awardList.map((award) => (
            <li class="py-3 first:pt-0 last:pb-0">
              <div class="flex items-baseline justify-between gap-2">
                <span class="text-sm font-medium text-fg">{award.title}</span>
                <span class="font-mono text-[0.6875rem] text-fg-muted tabular-nums">{award.period}</span>
              </div>
              <p class="mt-0.5 font-mono text-[0.6875rem] text-accent">{award.issuer}</p>
              {award.note && <p class="mt-1 text-xs leading-relaxed text-fg-secondary">{award.note}</p>}
            </li>
          ))
        }
      </ul>
    </section>
  </div>

  <h2>{t("about.languages")}</h2>
  <p class="text-base leading-7">{content.languages}</p>

  <div class="not-prose mt-10 flex flex-wrap gap-3 border-t border-border pt-8">
    <a
      href={cvUrl}
      target="_blank"
      rel="noopener"
      class="inline-flex items-center gap-2 rounded-full bg-fg px-5 py-2.5 text-sm font-medium text-bg transition-colors hover:bg-accent hover:text-accent-fg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
    >
      {t("cv.view")}
      <span aria-hidden="true">↗</span>
    </a>
    <a
      href={cvPdfPath}
      download="Bui-Khuong-Duy-(Timi)-FE-EN-2026.pdf"
      type="application/pdf"
      class="inline-flex items-center gap-2 rounded-full border border-border-strong bg-surface-elevated px-5 py-2.5 text-sm font-medium text-fg transition-colors hover:border-fg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
    >
      {t("cv.download")}
      <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4">
        <path d="M12 4v11"></path>
        <path d="m7 10 5 5 5-5"></path>
        <path d="M5 20h14"></path>
      </svg>
    </a>
  </div>
</SectionPage>

<script>
  function refreshCurrentMonth() {
    const now = new Date();
    const month = String(now.getMonth() + 1).padStart(2, "0");
    document.querySelectorAll<HTMLTimeElement>("time[data-current-month]").forEach((el) => {
      el.dateTime = `${now.getFullYear()}-${month}`;
      el.textContent =
        el.dataset.lang === "vi"
          ? `${month}/${now.getFullYear()}`
          : now.toLocaleDateString("en-US", { month: "short", year: "numeric" });
    });
  }
  refreshCurrentMonth();
  document.addEventListener("astro:page-load", refreshCurrentMonth);
</script>
