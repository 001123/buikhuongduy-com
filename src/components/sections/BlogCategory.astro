---
import SectionPage from "../../layouts/SectionPage.astro";
import CategoryNav from "../CategoryNav.astro";
import Pagination from "../Pagination.astro";
import PostList from "../PostList.astro";
import type { CategorySlug } from "../../data/categories";
import { getLang, sectionPaths, useTranslations, type Lang } from "../../i18n/ui";
import { categoryPath, pageCount, pagePath, pagePosts, postUrl, type Post } from "../../lib/blog";

interface Props {
  category: { slug: CategorySlug; name: string; title: string; description: string; intro: string; posts: Post[] };
  /** Listing page number within the category. */
  page: number;
  alternates: Record<Lang, string>;
  translations: Partial<Record<Lang, string>>;
  noindex: boolean;
}

const { category, page, alternates, translations, noindex } = Astro.props;
const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const base = categoryPath(lang, category.slug);
const posts = pagePosts(category.posts, page);
---

<SectionPage
  section="blog"
  title={category.title}
  lead={category.intro}
  description={category.description}
  page={page}
  alternates={alternates}
  translations={translations}
  noindex={noindex}
  breadcrumbs={[
    { name: t("nav.blog"), path: sectionPaths.blog[lang] },
    { name: category.name, path: base },
    ...(page > 1 ? [{ name: `${t("blog.page")} ${page}`, path: pagePath(base, page) }] : []),
  ]}
  itemList={posts.map(postUrl)}
  backHref={sectionPaths.blog[lang]}
  backLabel={t("blog.back")}
>
  <CategoryNav current={category.slug} />
  <PostList posts={posts} />
  <Pagination base={base} current={page} total={pageCount(category.posts.length)} />
</SectionPage>
