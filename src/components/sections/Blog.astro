---
import SectionPage from "../../layouts/SectionPage.astro";
import CategoryNav from "../CategoryNav.astro";
import PostList from "../PostList.astro";
import { getLang, useTranslations } from "../../i18n/ui";
import { getPosts, postUrl } from "../../lib/blog";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const posts = await getPosts(lang);
---

<SectionPage section="blog" title={t("blog.title")} lead={t("blog.lead")} itemList={posts.map(postUrl)}>
  {
    posts.length === 0 ? (
      <p class="text-paper/70 italic">{t("blog.empty")}</p>
    ) : (
      <>
        <CategoryNav />
        <PostList posts={posts} />
      </>
    )
  }
</SectionPage>
