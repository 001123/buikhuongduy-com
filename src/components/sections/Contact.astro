---
import SectionPage from "../../layouts/SectionPage.astro";
import ContactIcon, { type IconName } from "../ContactIcon.astro";
import { getLang, useTranslations } from "../../i18n/ui";
import { cvPdfPath, cvUrl, email, socials } from "../../data/profile";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

const links: { label: string; icon: IconName; value: string; href: string }[] = [
  ...socials.map((s) => ({ label: s.label, icon: s.icon, value: s.href.replace(/^https?:\/\/(www\.)?/, ""), href: s.href })),
  { label: t("cv.view"), icon: "cv", value: cvUrl.replace(/^https?:\/\//, ""), href: cvUrl },
];
---

<SectionPage section="contact" title={t("contact.title")} lead={t("contact.lead")}>
  <div class="not-prose rounded-2xl border border-border bg-surface-elevated p-5 sm:p-7">
    <div class="mb-3 flex items-center justify-between border-b border-border pb-3 font-mono text-[0.6875rem] uppercase tracking-[0.12em] text-fg-muted">
      <span class="inline-flex items-center gap-2 text-fg-secondary">
        <span aria-hidden="true" class="size-2 rounded-full bg-status-open"></span>
        {t("hero.status")}
      </span>
    </div>

    <div class="divide-y divide-border">
      <div class="flex flex-wrap items-center justify-between gap-3 py-4">
        <a
          href={`mailto:${email}`}
          class="group inline-flex items-center gap-3 font-medium text-fg transition-colors hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
        >
          <ContactIcon name="email" class="size-4.5 shrink-0 text-fg-muted transition-colors group-hover:text-accent" />
          <span>{t("contact.email")}</span>
        </a>
        <div class="flex items-center gap-3">
          <a
            href={`mailto:${email}`}
            class="font-mono text-xs text-fg-secondary transition-colors hover:text-accent sm:text-sm"
          >
            {email}
          </a>
          <button
            type="button"
            data-copy-email={email}
            data-label-idle={t("contact.copyEmail")}
            data-label-done={t("contact.emailCopied")}
            class="rounded-md border border-border bg-surface px-2.5 py-1 font-mono text-xs text-fg-muted transition-colors hover:border-border-strong hover:text-fg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
          >
            {t("contact.copyEmail")}
          </button>
        </div>
      </div>

      {
        links.map((l) => (
          <a
            href={l.href}
            target="_blank"
            rel="noopener"
            class="group flex items-center justify-between gap-4 py-4 transition-colors hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
          >
            <span class="flex items-center gap-3 font-medium text-fg transition-colors group-hover:text-accent">
              <ContactIcon name={l.icon} class="size-4.5 shrink-0 text-fg-muted transition-colors group-hover:text-accent" />
              {l.label}
            </span>
            <span class="truncate font-mono text-xs text-fg-muted transition-colors group-hover:text-accent sm:text-sm">
              {l.value} ↗
            </span>
          </a>
        ))
      }

      <a
        href={cvPdfPath}
        download="Bui-Khuong-Duy-(Timi)-FE-EN-2026.pdf"
        type="application/pdf"
        class="group flex items-center justify-between gap-4 py-4 pb-1 transition-colors hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
      >
        <span class="flex items-center gap-3 font-medium text-fg transition-colors group-hover:text-accent">
          <ContactIcon name="cv" class="size-4.5 shrink-0 text-fg-muted transition-colors group-hover:text-accent" />
          {t("cv.download")}
        </span>
        <span class="font-mono text-xs text-fg-muted transition-colors group-hover:text-accent sm:text-sm">PDF ↓</span>
      </a>
    </div>
  </div>
</SectionPage>

<script>
  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll<HTMLButtonElement>("[data-copy-email]").forEach((btn) => {
      if (btn.dataset.bound) return;
      btn.dataset.bound = "1";
      let timer: number | undefined;
      btn.addEventListener("click", async () => {
        const value = btn.dataset.copyEmail ?? "";
        try {
          await navigator.clipboard.writeText(value);
        } catch {
          window.prompt("", value);
          return;
        }
        btn.textContent = btn.dataset.labelDone ?? "Copied";
        clearTimeout(timer);
        timer = window.setTimeout(() => {
          btn.textContent = btn.dataset.labelIdle ?? "Copy";
        }, 1800);
      });
    });
  });
</script>
