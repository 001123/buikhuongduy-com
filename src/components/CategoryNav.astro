---
import type { CategorySlug } from "../data/categories";
import { getLang, sectionPaths, useTranslations } from "../i18n/ui";
import { categoryPath, getCategories } from "../lib/blog";

interface Props {
  /** Current category; omit on the blog index. */
  current?: CategorySlug;
}

const { current } = Astro.props;
const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const cats = await getCategories(lang);
const chip =
  "inline-flex items-center gap-1.5 rounded-full border px-3 py-1 text-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rice";
const idle = "glow-hover border-paper/20 text-paper/80 hover:border-rice hover:text-rice";
const active = "border-rice bg-rice/10 text-rice";
---

{
  cats.length > 0 && (
    <nav aria-label={t("blog.categories")} class="not-prose mb-8">
      <ul class="flex flex-wrap gap-2">
        <li>
          <a href={sectionPaths.blog[lang]} class:list={[chip, current ? idle : active]} aria-current={current ? undefined : "page"}>
            {t("blog.allTopics")}
          </a>
        </li>
        {cats.map((c) => (
          <li>
            <a href={categoryPath(lang, c.slug)} class:list={[chip, c.slug === current ? active : idle]} aria-current={c.slug === current ? "page" : undefined}>
              {c.name}
              <span class="text-xs text-paper/50">{c.posts.length}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}
