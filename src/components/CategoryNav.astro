---
import type { CategorySlug } from "../data/categories";
import { getLang, sectionPaths, useTranslations } from "../i18n/ui";
import { categoryPath, getCategories, getPosts } from "../lib/blog";

interface Props {
  /** Current category; omit on the blog index. */
  current?: CategorySlug;
}

const { current } = Astro.props;
const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const [cats, allPosts] = await Promise.all([getCategories(lang), getPosts(lang)]);
const tab =
  "inline-flex shrink-0 items-center gap-1.5 whitespace-nowrap border-b-2 px-0.5 pt-1 pb-3 text-[0.8125rem] font-medium transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent";
const idle = "border-transparent text-fg-muted hover:border-border-strong hover:text-fg";
const active = "border-accent text-fg";
---

{
  cats.length > 0 && (
    <nav aria-label={t("blog.categories")} class="not-prose mb-8 border-b border-border">
      <ul class="no-scrollbar -mb-px flex items-center gap-5 overflow-x-auto sm:gap-6">
        <li class="shrink-0">
          <a
            href={sectionPaths.blog[lang]}
            class:list={[tab, current ? idle : active]}
            aria-current={current ? undefined : "page"}
          >
            <span>{t("blog.allTopics")}</span>
            <span class:list={["font-mono text-[0.6875rem] tabular-nums", current ? "text-fg-muted/70" : "text-accent"]}>
              {allPosts.length}
            </span>
          </a>
        </li>
        {
          cats.map((c) => (
            <li class="shrink-0">
              <a
                href={categoryPath(lang, c.slug)}
                class:list={[tab, c.slug === current ? active : idle]}
                aria-current={c.slug === current ? "page" : undefined}
              >
                <span>{c.name}</span>
                <span
                  class:list={[
                    "font-mono text-[0.6875rem] tabular-nums",
                    c.slug === current ? "text-accent" : "text-fg-muted/70",
                  ]}
                >
                  {c.posts.length}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  )
}
