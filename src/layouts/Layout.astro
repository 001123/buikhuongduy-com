---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import { Font } from "astro:assets";
import LanguageSwitcher from "../components/LanguageSwitcher.astro";
import CursorEffects from "../components/CursorEffects.astro";
import { defaultLang, getLang, homePath, languages, locales, useTranslations, type Lang } from "../i18n/ui";
import { cleanText, structuredData, type ArticleMeta, type Crumb, type PageType } from "../lib/seo";
import type { PageDates } from "../lib/git-dates";

interface Props {
  title?: string;
  description?: string;
  /** Path of this page in each language. Defaults to the home page. */
  alternates?: Partial<Record<Lang, string>>;
  /** Languages that have a real translation of this page (for hreflang). Defaults to `alternates`. */
  translations?: Partial<Record<Lang, string>>;
  /** schema.org type of this page. */
  pageType?: PageType;
  /** Set on blog posts to emit article metadata. */
  article?: ArticleMeta;
  /** Disable the fixed language switcher when the page places it elsewhere. */
  floatingLangSwitcher?: boolean;
  /** Keep the page out of search results (e.g. 404); also drops canonical, hreflang and JSON-LD. */
  noindex?: boolean;
  /** Breadcrumb trail after Home, for JSON-LD. */
  breadcrumbs?: Crumb[];
  /** Paths listed by a CollectionPage, for JSON-LD. */
  itemList?: string[];
  /** When the page was first published and last changed, for JSON-LD. */
  dates?: PageDates;
}

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

const {
  title = t("seo.homeTitle"),
  description: rawDescription = t("site.description"),
  alternates = {},
  translations,
  pageType = "ProfilePage",
  article,
  floatingLangSwitcher = true,
  noindex = false,
  breadcrumbs,
  itemList,
  dates,
} = Astro.props;
const description = cleanText(rawDescription);

const links = Object.fromEntries(
  (Object.keys(languages) as Lang[]).map((l) => [l, alternates[l] ?? homePath[l]]),
) as Record<Lang, string>;
const site = Astro.site ?? Astro.url;
const ogImage = new URL(article?.image ?? "/og-image.jpg", site);
const ogImageType = article?.image ? "image/png" : "image/jpeg";
const ogImageAlt = article?.image ? title : t("seo.ogImageAlt");
const pageUrl = new URL(Astro.url.pathname, site);

// hreflang: only languages with a real translation, plus x-default on the Vietnamese (primary) version.
const hreflangs = Object.entries(translations ?? links).map(([l, href]) => [l, new URL(href, site).href]);
const xDefault = hreflangs.find(([l]) => l === defaultLang)?.[1];
const otherLocales = (Object.keys(languages) as Lang[]).filter((l) => l !== lang && hreflangs.some(([h]) => h === l));

const ogType = article ? "article" : pageType === "ProfilePage" ? "profile" : "website";

const jsonLd = structuredData({
  lang,
  site,
  pageUrl,
  title,
  description,
  pageType: article ? "WebPage" : pageType,
  image: ogImage,
  // Stable URL served by src/pages/avatar.webp.ts (hashed asset names change between builds).
  avatar: new URL("/avatar.webp", site),
  article,
  breadcrumbs,
  itemList,
  dates,
});
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content={t("site.name")} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"} />
    {
      !noindex && (
        <>
          <link rel="canonical" href={pageUrl} />
          {hreflangs.map(([l, href]) => <link rel="alternate" hreflang={l} href={href} />)}
          {xDefault && <link rel="alternate" hreflang="x-default" href={xDefault} />}
        </>
      )
    }
    <meta property="og:site_name" content={t("site.name")} />
    <meta property="og:locale" content={locales[lang].og} />
    {otherLocales.map((l) => <meta property="og:locale:alternate" content={locales[l].og} />)}
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={pageUrl} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content={ogImageType} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    {
      article ? (
        <>
          <meta property="article:published_time" content={article.publishedTime.toISOString()} />
          {article.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime.toISOString()} />}
          <meta property="article:author" content={new URL(homePath[lang], site).href} />
          {article.section && <meta property="article:section" content={article.section} />}
          {article.tags.map((tag) => <meta property="article:tag" content={tag} />)}
        </>
      ) : ogType === "profile" && (
        <>
          <meta property="profile:first_name" content="Duy" />
          <meta property="profile:last_name" content={lang === "vi" ? "Bùi" : "Bui"} />
          <meta property="profile:username" content="buikhuongduy" />
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@khuongduy1897" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <Font cssVariable="--font-be-vietnam-pro" preload={[{ weight: 400, style: "normal", subset: "latin" }, { weight: 400, style: "normal", subset: "vietnamese" }]} />
    <Font cssVariable="--font-fraunces" preload={[{ weight: 600, style: "normal", subset: "latin" }, { weight: 600, style: "normal", subset: "vietnamese" }]} />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <ClientRouter />
    <script is:inline>
      // Apply the blog reading mode before first paint to avoid a content flash.
      // A `?mode=` URL param (shared links) wins over the reader's saved preference.
      (function () {
        function applyReadingMode(doc, url) {
          var m = new URL(url).searchParams.get("mode");
          if (m !== "tldr" && m !== "normal" && m !== "advanced") {
            try {
              m = localStorage.getItem("reading-mode");
            } catch (e) {}
          }
          if (m === "tldr" || m === "advanced") doc.documentElement.dataset.readingMode = m;
        }
        applyReadingMode(document, location.href);
        if (!window.__readingModeHooked) {
          window.__readingModeHooked = true;
          // View transitions replace <html> attributes; restore the mode on the incoming page before it is swapped in.
          document.addEventListener("astro:before-swap", function (e) {
            applyReadingMode(e.newDocument, e.to.href);
          });
        }
      })();
    </script>
  </head>
  <body class="bg-ink font-sans text-paper antialiased">
    {floatingLangSwitcher && <LanguageSwitcher lang={lang} links={links} />}
    <slot />
    <CursorEffects />
    <script>
      document.addEventListener("astro:after-swap", () => {
        document.documentElement.classList.add("navigated");
      });
    </script>
  </body>
</html>
