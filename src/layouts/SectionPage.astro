---
import Layout from "./Layout.astro";
import Background from "../components/Background.astro";
import LanguageSwitcher from "../components/LanguageSwitcher.astro";
import ScrollToTop from "../components/ScrollToTop.astro";
import { contentAnim } from "../components/transitions";
import { getLang, homePath, sectionPaths, useTranslations, type Lang, type Section } from "../i18n/ui";
import type { ArticleMeta, PageType } from "../lib/seo";

interface Props {
  section: Section;
  title: string;
  lead: string;
  /** Meta description. Defaults to the section's SEO description. */
  description?: string;
  /** Languages with a real translation of this page (for hreflang). Defaults to `alternates`. */
  translations?: Partial<Record<Lang, string>>;
  /** Set on blog posts to emit article metadata. */
  article?: ArticleMeta;
  /** Path of this page in each language. Defaults to the section paths. */
  alternates?: Record<Lang, string>;
  /** Back link target. Defaults to the home page. */
  backHref?: string;
  backLabel?: string;
}

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const {
  section,
  title,
  lead,
  description = t(`seo.${section}`),
  translations,
  article,
  alternates = sectionPaths[section],
  backHref = homePath[lang],
  backLabel = t("nav.home"),
} = Astro.props;

const pageTypes: Record<Section, PageType> = {
  about: "ProfilePage",
  blog: "CollectionPage",
  contact: "ContactPage",
};
---

<Layout
  title={`${title} · ${t("site.name")}`}
  description={description}
  alternates={alternates}
  translations={translations}
  pageType={pageTypes[section]}
  article={article}
  floatingLangSwitcher={false}
>
  <main class="relative isolate min-h-dvh px-2.5 py-4 sm:px-6 sm:py-8">
    <Background dim />

    <article class="relative mx-auto max-w-[54rem] rounded-2xl border border-paper/15 bg-ink px-4 pt-5 pb-8 sm:rounded-3xl shadow-2xl shadow-ink/50 sm:px-12 sm:pt-9 sm:pb-14" transition:name={`content-${section}`} transition:animate={contentAnim}>
      <!-- Subtle golden light streak along the top edge -->
      <span aria-hidden="true" class="pointer-events-none absolute inset-x-[30%] -top-px h-px bg-gradient-to-r from-transparent via-rice/55 to-transparent"></span>
      <span aria-hidden="true" class="pointer-events-none absolute inset-x-[38%] -top-1.5 h-3 rounded-full bg-rice/[0.08] blur-md"></span>
      <div class="mb-6 flex items-center justify-between gap-3 sm:mb-9">
        <a
          href={backHref}
          class="inline-flex items-center gap-1.5 rounded-full border border-paper/40 bg-ink/40 px-3 py-1.5 text-sm font-medium text-paper shadow-lg shadow-ink/30 backdrop-blur-md glow-hover hover:border-rice hover:text-rice focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rice"
        >
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4">
            <path d="M15 18l-6-6 6-6"></path>
          </svg>
          {backLabel}
        </a>
        <LanguageSwitcher lang={lang} links={alternates} class="" />
      </div>
      <header class="mb-8 flex flex-col items-start gap-3 sm:mb-10 sm:gap-4">
        <h1 class="font-serif text-[clamp(1.75rem,7vw,3.5rem)] leading-tight font-semibold tracking-wide text-paper">{title}</h1>
        <span aria-hidden="true" class="h-px w-24 bg-linear-to-r from-rice to-transparent sm:w-40"></span>
        <p class="text-base text-pretty text-paper/80 sm:text-lg">{lead}</p>
        <slot name="meta" />
      </header>
      <div class="prose prose-invert max-w-none max-sm:text-[0.9375rem] [--tw-prose-invert-body:color-mix(in_oklab,var(--color-paper)_88%,transparent)] prose-headings:font-serif prose-headings:text-paper prose-a:text-rice prose-a:glow-text-hover prose-strong:text-paper">
        <slot />
      </div>
    </article>
    <ScrollToTop />
  </main>
</Layout>
