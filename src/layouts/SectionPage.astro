---
import Layout from "./Layout.astro";
import { contentAnim } from "../components/transitions";
import { getLang, sectionPaths, useTranslations, type Lang, type Section } from "../i18n/ui";
import type { ArticleMeta, Crumb, PageType } from "../lib/seo";
import type { PageDates } from "../lib/git-dates";

interface Props {
  section: Section;
  title: string;
  /** Shorter document title for search results. Blog posts only; defaults to `title`. */
  seoTitle?: string;
  lead: string;
  /** Meta description. Defaults to the section's SEO description. */
  description?: string;
  /** Languages with a real translation of this page (for hreflang). Defaults to `alternates`. */
  translations?: Partial<Record<Lang, string>>;
  /** Set on blog posts to emit article metadata. */
  article?: ArticleMeta;
  /** Path of this page in each language. Defaults to the section paths. */
  alternates?: Record<Lang, string>;
  /** Optional back link shown above the page header (e.g. on blog posts and category pages). */
  backHref?: string;
  backLabel?: string;
  /** Keep this page out of search results. */
  noindex?: boolean;
  /** Breadcrumb trail after Home, for JSON-LD. */
  breadcrumbs?: Crumb[];
  /** Paths listed by a CollectionPage, for JSON-LD. */
  itemList?: string[];
  /** When the page was first published and last changed, for JSON-LD. */
  dates?: PageDates;
  /** Listing page number; pages after the first get it in the document title and description. */
  page?: number;
}

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const {
  section,
  title,
  seoTitle,
  lead,
  description = t(`seo.${section}`),
  translations,
  article,
  alternates = sectionPaths[section],
  backHref,
  backLabel = t("nav.back"),
  noindex,
  breadcrumbs,
  itemList,
  dates,
  page = 1,
} = Astro.props;

const pageLabel = page > 1 ? `${t("blog.page")} ${page}` : "";
const docTitle = article ? (seoTitle ?? title) : [title, pageLabel, t("site.name")].filter(Boolean).join(" · ");
const docDescription = pageLabel ? `${description} (${pageLabel})` : description;

const pageTypes: Record<Section, PageType> = {
  about: "ProfilePage",
  blog: "CollectionPage",
  contact: "ContactPage",
  search: "SearchResultsPage",
};

const kicker = t(`section.${section}Kicker`);
---

<Layout
  title={docTitle}
  socialTitle={article ? title : docTitle}
  description={docDescription}
  alternates={alternates}
  translations={translations}
  pageType={pageTypes[section]}
  article={article}
  noindex={noindex}
  breadcrumbs={breadcrumbs}
  itemList={itemList}
  dates={dates}
>
  {article && <div aria-hidden="true" class="reading-progress"></div>}

  <article
    class:list={[
      "mx-auto px-5 pt-10 pb-16 sm:px-8 sm:pt-14 sm:pb-24",
      article ? "max-w-[46rem]" : "max-w-[52rem]",
    ]}
    transition:name={`content-${section}`}
    transition:animate={contentAnim}
  >
    {
      backHref && (
        <div class="mb-6">
          <a
            href={backHref}
            class="inline-flex items-center gap-1.5 font-mono text-xs text-fg-muted transition-colors hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
          >
            <span aria-hidden="true">←</span>
            {backLabel}
          </a>
        </div>
      )
    }

    <header class="mb-10 flex flex-col items-start gap-3 border-b border-border pb-7">
      {!article && <p class="font-mono text-[0.6875rem] font-medium uppercase tracking-[0.14em] text-accent">{kicker}</p>}
      <h1
        class:list={[
          "font-semibold tracking-[-0.03em] text-pretty text-fg",
          article
            ? "text-[clamp(1.625rem,4.5vw,2.375rem)] leading-[1.16]"
            : "text-[clamp(2rem,5vw,2.75rem)] leading-[1.12]",
        ]}
      >
        {title}
      </h1>
      <p class="text-base leading-relaxed text-pretty text-fg-secondary sm:text-[1.0625rem]">{lead}</p>
      <slot name="meta" />
    </header>

    <div class="prose prose-editorial max-w-none">
      <slot />
    </div>
  </article>
</Layout>
